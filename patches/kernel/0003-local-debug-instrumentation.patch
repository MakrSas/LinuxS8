diff --git a/drivers/mmc/host/dw_mmc.c b/drivers/mmc/host/dw_mmc.c
index d734d0104..057f56097 100644
--- a/drivers/mmc/host/dw_mmc.c
+++ b/drivers/mmc/host/dw_mmc.c
@@ -1830,7 +1830,39 @@ static int dw_mci_data_complete(struct dw_mci *host, struct mmc_data *data)
 			data->error = -EILSEQ;
 		}
 
-		dev_dbg(host->dev, "data error, status 0x%08x\n", status);
+		/*
+		 * The opcode and R1 separate a host-side fault from the card
+		 * refusing the transfer: R1 bit 25 CARD_IS_LOCKED, bit 31
+		 * OUT_OF_RANGE, bit 30 ADDRESS_ERROR, and the current state in
+		 * bits 12:9 (4 == tran) are all invisible otherwise, because
+		 * dw_mmc never inspects the response of a data command.
+		 */
+		dev_err(host->dev, "data err %08x cmd%u arg %08x r1 %08x\n",
+			status, data->mrq->cmd->opcode, data->mrq->cmd->arg,
+			data->mrq->cmd->resp[0]);
+
+		/*
+		 * TCBCNT/TBBCNT are the only witnesses to whether any data
+		 * crossed the card interface at all: TCBCNT counts bytes the
+		 * CIU moved to/from the card, TBBCNT bytes the BIU moved
+		 * to/from the FIFO. Both have to be sampled here, before the
+		 * dw_mci_reset() below clears them. DRTO with tcb == 0 means
+		 * the card never drove a start bit; tcb == blksz would mean it
+		 * sent the block and the timeout has some other cause.
+		 *
+		 * Rate-limited because the block layer retries every failing
+		 * sector and the console is being read off a photograph.
+		 */
+		if (host->dbg_data_err++ < 3) {
+			dev_err(host->dev, "  tcb %u tbb %u sts %08x cmd %08x blk %u/%u\n",
+				mci_readl(host, TCBCNT), mci_readl(host, TBBCNT),
+				mci_readl(host, STATUS), mci_readl(host, CMD),
+				mci_readl(host, BLKSIZ), mci_readl(host, BYTCNT));
+			dev_err(host->dev, "  ctrl %08x ctype %08x clkena %08x clkdiv %08x tmout %08x fifoth %08x\n",
+				mci_readl(host, CTRL), mci_readl(host, CTYPE),
+				mci_readl(host, CLKENA), mci_readl(host, CLKDIV),
+				mci_readl(host, TMOUT), mci_readl(host, FIFOTH));
+		}
 
 		/*
 		 * After an error, there may be data lingering
@@ -2919,6 +2951,19 @@ static void dw_mci_init_dma(struct dw_mci *host)
 	* simpler request/acknowledge handshake mechanism and both of them
 	* are regarded as external dma master for dw_mmc.
 	*/
+	/*
+	 * The binding documents "fifo-mode" as "Enables FIFO mode, i.e. PIO"
+	 * but nothing here ever honoured it -- the transfer mode is taken
+	 * purely from HCON. Needed on exynos8895-dreamlte, where IDMAC in
+	 * 64-bit mode fails every data transfer (commands are fine, so the
+	 * card enumerates and then every read returns -EIO) on a board whose
+	 * RAM extends past 4G.
+	 */
+	if (device_property_read_bool(host->dev, "fifo-mode")) {
+		dev_info(host->dev, "fifo-mode requested, using PIO\n");
+		goto no_dma;
+	}
+
 	host->use_dma = SDMMC_GET_TRANS_MODE(mci_readl(host, HCON));
 	if (host->use_dma == DMA_INTERFACE_IDMA) {
 		host->use_dma = TRANS_MODE_IDMAC;
diff --git a/drivers/mmc/host/dw_mmc.h b/drivers/mmc/host/dw_mmc.h
index 9ffcd3946..a79302e92 100644
--- a/drivers/mmc/host/dw_mmc.h
+++ b/drivers/mmc/host/dw_mmc.h
@@ -166,6 +166,7 @@ struct dw_mci {
 	u32			data_addr_override;
 	u32			dma_threshold;
 	bool			wm_aligned;
+	unsigned int		dbg_data_err;	/* rate-limits the data error dump */
 
 	struct scatterlist	*sg;
 	struct sg_mapping_iter	sg_miter;
