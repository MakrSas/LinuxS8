+/*
+ * Атрибуты M-PHY (tx_dif_*, rx_*_nsec и прочие тайминги) здесь намеренно не
+ * заданы: с EXYNOS_UFS_OPT_SKIP_CONFIG_PHY_ATTR они не используются, а у
+ * даунстрима обе функции, которые их пишут, для hw_rev >= UFS_VER_0004
+ * выходят сразу же.
+ *
+ * pa_dbg_clk_period_off оставлен нулём осознанно — см. комментарий в
+ * exynos8895_ufs_pre_link() про округление периода такта.
+ */
+static struct exynos_ufs_uic_attr exynos8895_uic_attr = {
+	.tx_trailingclks		= 0x10,
+	.pa_dbg_opt_suite1_val		= 0x2e820183,
+	.pa_dbg_opt_suite1_off		= PA_DBG_OPTION_SUITE,
+};
