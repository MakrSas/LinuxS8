diff --git a/drivers/phy/samsung/phy-exynos8895-ufs.c b/drivers/phy/samsung/phy-exynos8895-ufs.c
new file mode 100644
index 000000000..c5a46cf86
--- /dev/null
+++ b/drivers/phy/samsung/phy-exynos8895-ufs.c
@@ -0,0 +1,174 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * UFS PHY driver data for Samsung Exynos8895 SoC
+ *
+ * Значения взяты из вендорского ядра Samsung для universal8895
+ * (android_kernel_samsung_universal8895), где вся калибровка PMA лежит не в
+ * коде, а прямо в dts — в узле ufs@0x11120000, свойства phy-init,
+ * calib-of-hs-rate-b и post-calib-of-hs-rate-b. Записи с типом PHY_PMA_COMN
+ * и PHY_PMA_TRSV — это и есть наша таблица.
+ *
+ * Адресация PMA у Exynos8895 отличается от Exynos7420, и это важно:
+ *
+ *   downstream ufs-exynos.h, ветка !EXYNOS7420 && !EXYNOS8890:
+ *     PHY_PMA_COMN_ADDR(reg)       (reg)
+ *     PHY_PMA_TRSV_ADDR(reg, lane) ((reg) + (0x140 * (lane)))
+ *
+ * то есть в вендорской таблице смещения уже байтовые, а шаг между линиями
+ * 0x140 байт. Здесь же макросы phy-samsung-ufs.h принимают НОМЕР регистра и
+ * сами домножают на 4 (PHY_APB_ADDR). Поэтому все смещения ниже поделены на
+ * 4, а шаг линии равен 0x140 / 4 = 0x50. Байтовый адрес из даунстрима указан
+ * в комментарии к каждой строке, чтобы сверка была механической.
+ *
+ * Блок COMN занимает 0x000..0x0BF, TRSV линии 0 начинается с 0x0C0, линии 1
+ * с 0x200 — отсюда сходятся вендорские подписи вида "TRSVx_14(0x110/0x250)".
+ */
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+
+#include "phy-samsung-ufs.h"
+
+/*
+ * Регистр изоляции PHY в PMU. У Exynos7420 это 0x0720, у нас 0x0724 —
+ * подтверждено даунстримом дважды: литералом 0x16480724 в подузле
+ * ufs-phy-sys узла ufs, и местом записи exynos_ufs_ctrl_phy_pwr(), где в
+ * этот регистр пишется просто 1, чтобы снять изоляцию.
+ */
+#define EXYNOS8895_EMBEDDED_COMBO_PHY_CTRL	0x0724
+#define EXYNOS8895_EMBEDDED_COMBO_PHY_CTRL_MASK	0x1
+#define EXYNOS8895_EMBEDDED_COMBO_PHY_CTRL_EN	BIT(0)
+
+/* шаг между линиями TRSV: 0x140 байт = 0x50 регистров */
+#define PHY_EXYNOS8895_LANE_OFFSET		0x50
+
+/* монитор захвата CDR, байтовое смещение 0x1FC у линии 0 */
+#define EXYNOS8895_PHY_CDR_LOCK_STATUS		0x7F
+#define EXYNOS8895_PHY_CDR_LOCK_DONE		BIT(0)
+
+/* пауза COMMON_WAIT из хвоста вендорской phy-init, мкс */
+#define EXYNOS8895_PHY_CAL_WAIT_US		200
+
+#define PHY_TRSV_REG_CFG_E8895(o, v, d)	\
+	PHY_TRSV_REG_CFG_OFFSET(o, v, d, PHY_EXYNOS8895_LANE_OFFSET)
+
+/*
+ * Калибровка перед стартом линка (вендорское свойство phy-init, часть
+ * PHY_PMA_*). Обрамление 0x8C: 0x80 -> настройка -> 0xC0 -> 0x00 — это
+ * вендорская последовательность применения, её порядок значим.
+ */
+static const struct samsung_ufs_phy_cfg exynos8895_pre_init_cfg[] = {
+	PHY_COMN_REG_CFG(0x023, 0x80, PWR_MODE_ANY),	/* 0x08C */
+	/* CMN_REG1D: источник PWM-такта, 0x10 = refclk (0x20 = внутренний OSC) */
+	PHY_COMN_REG_CFG(0x01d, 0x10, PWR_MODE_ANY),	/* 0x074 */
+	PHY_TRSV_REG_CFG_E8895(0x044, 0xb5, PWR_MODE_ANY),	/* 0x110 */
+	PHY_TRSV_REG_CFG_E8895(0x04d, 0x43, PWR_MODE_ANY),	/* 0x134 */
+	PHY_TRSV_REG_CFG_E8895(0x05b, 0x20, PWR_MODE_ANY),	/* 0x16C */
+	PHY_TRSV_REG_CFG_E8895(0x05e, 0xc0, PWR_MODE_ANY),	/* 0x178 */
+	PHY_TRSV_REG_CFG_E8895(0x038, 0x12, PWR_MODE_ANY),	/* 0x0E0 */
+	PHY_TRSV_REG_CFG_E8895(0x059, 0x58, PWR_MODE_ANY),	/* 0x164 */
+	PHY_COMN_REG_CFG(0x023, 0xc0, PWR_MODE_ANY),	/* 0x08C */
+	PHY_COMN_REG_CFG(0x023, 0x00, PWR_MODE_ANY),	/* 0x08C */
+	END_UFS_PHY_CFG,
+};
+
+/*
+ * Калибровка под HS (вендорское calib-of-hs-rate-b, часть PHY_PMA_TRSV).
+ *
+ * У даунстрима записи 0x128/0x12C/0x134 расписаны отдельно для G1/G2/G3, а
+ * в mainline поле .desc сейчас не фильтруется вовсе (samsung_ufs_phy_calibrate
+ * применяет таблицу целиком), поэтому оставлены только значения для G3 —
+ * именно эту передачу и просит dts даунстрима (pmd-attr-gear = 3,
+ * hs-series = HS_rate_b). Если понадобится G1/G2, фильтрацию по .desc
+ * придётся сначала вернуть в phy-samsung-ufs.c.
+ *
+ * Таблицы rate-a и rate-b в даунстриме побайтово совпадают, так что эта
+ * годится для обеих серий.
+ */
+static const struct samsung_ufs_phy_cfg exynos8895_pre_pwr_hs_cfg[] = {
+	PHY_TRSV_REG_CFG_E8895(0x032, 0xbc, PWR_MODE_HS_ANY),	/* 0x0C8 */
+	/* TX_SLEW_PREEMP_EN_CTRL_EN = 1 */
+	PHY_TRSV_REG_CFG_E8895(0x03c, 0x7f, PWR_MODE_HS_ANY),	/* 0x0F0 */
+	/* TX_AMPL_CNTR_EN = 1 */
+	PHY_TRSV_REG_CFG_E8895(0x048, 0xc0, PWR_MODE_HS_ANY),	/* 0x120 */
+	/* TX_AMPL_CTRL = 0 (G3A/B) */
+	PHY_TRSV_REG_CFG_E8895(0x04a, 0x00, PWR_MODE_HS_G3_ANY),	/* 0x128 */
+	/* TX_PREEMP_CTRL = 0 dB */
+	PHY_TRSV_REG_CFG_E8895(0x04b, 0x00, PWR_MODE_HS_ANY),	/* 0x12C */
+	/* TX_AUX_CAP_CTRL = 3b'110 (G3A/B) */
+	PHY_TRSV_REG_CFG_E8895(0x04d, 0x63, PWR_MODE_HS_G3_ANY),	/* 0x134 */
+	PHY_TRSV_REG_CFG_E8895(0x042, 0x5d, PWR_MODE_HS_ANY),	/* 0x108 */
+	PHY_TRSV_REG_CFG_E8895(0x043, 0x90, PWR_MODE_HS_ANY),	/* 0x10C */
+	END_UFS_PHY_CFG,
+};
+
+static const struct samsung_ufs_phy_cfg *exynos8895_ufs_phy_cfgs[CFG_TAG_MAX] = {
+	[CFG_PRE_INIT]		= exynos8895_pre_init_cfg,
+	[CFG_PRE_PWR_HS]	= exynos8895_pre_pwr_hs_cfg,
+};
+
+/*
+ * Один такт, а не четыре. У Exynos7420 PHY получает tx0/rx0/rx1_symbol_clk
+ * отдельными гейтами; у Exynos8895 таких гейтов в даунстриме нет вообще —
+ * узлу ufs отданы всего два клока (aclk и unipro), а PHY тактируется от
+ * опорного через мультиплексор внутри HCI (HCI_MPHY_REFCLK_SEL). Все SoC
+ * Samsung новее 7420 (autov9, autov920, gs101) объявляют ровно один ref_clk.
+ */
+static const char * const exynos8895_ufs_phy_clks[] = {
+	"ref_clk",
+};
+
+/*
+ * Хвост вендорской phy-init: <0x00 0xC8 PMD_ALL COMMON_WAIT>, то есть
+ * udelay(200) сразу после таблицы. Отдельного типа "подождать" в mainline
+ * нет, зато есть ровно подходящий по месту вызова хук wait_for_cal — он
+ * дёргается сразу после применения CFG_PRE_INIT.
+ */
+static int exynos8895_phy_wait_for_calibration(struct phy *phy, u8 lane)
+{
+	udelay(EXYNOS8895_PHY_CAL_WAIT_US);
+
+	return 0;
+}
+
+/*
+ * Вендорское post-calib-of-hs-rate-b: <0x1fc 0x01 PMD_HS PHY_CDR_WAIT>.
+ * Даунстрим ждёт до 100 мс, опрашивая бит 0 регистра TRSV по байтовому
+ * смещению 0x1FC (линия 0) / 0x33C (линия 1).
+ *
+ * Штатный samsung_ufs_phy_wait_for_lock_acq здесь не годится: он проверяет
+ * ещё и PLL lock по общему для exynos7 адресу, которого у нас нет.
+ */
+static int exynos8895_phy_wait_for_cdr_lock(struct phy *phy, u8 lane)
+{
+	struct samsung_ufs_phy *ufs_phy = get_samsung_ufs_phy(phy);
+	const unsigned int timeout_us = 100000;
+	const unsigned int sleep_us = 10;
+	u32 off;
+	u32 val;
+	int err;
+
+	off = PHY_APB_ADDR(EXYNOS8895_PHY_CDR_LOCK_STATUS +
+			   lane * PHY_EXYNOS8895_LANE_OFFSET);
+
+	err = readl_poll_timeout(ufs_phy->reg_pma + off, val,
+				 (val & EXYNOS8895_PHY_CDR_LOCK_DONE),
+				 sleep_us, timeout_us);
+	if (err)
+		dev_err(ufs_phy->dev, "failed to get cdr lock %d\n", err);
+
+	return err;
+}
+
+const struct samsung_ufs_phy_drvdata exynos8895_ufs_phy = {
+	.cfgs = exynos8895_ufs_phy_cfgs,
+	.isol = {
+		.offset = EXYNOS8895_EMBEDDED_COMBO_PHY_CTRL,
+		.mask = EXYNOS8895_EMBEDDED_COMBO_PHY_CTRL_MASK,
+		.en = EXYNOS8895_EMBEDDED_COMBO_PHY_CTRL_EN,
+	},
+	.clk_list = exynos8895_ufs_phy_clks,
+	.num_clks = ARRAY_SIZE(exynos8895_ufs_phy_clks),
+	.wait_for_cal = exynos8895_phy_wait_for_calibration,
+	.wait_for_cdr = exynos8895_phy_wait_for_cdr_lock,
+};
