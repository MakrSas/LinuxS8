diff --git a/drivers/gpu/drm/panel/panel-samsung-s6e3ha6.c b/drivers/gpu/drm/panel/panel-samsung-s6e3ha6.c
new file mode 100644
index 000000000..c2fab2ab1
--- /dev/null
+++ b/drivers/gpu/drm/panel/panel-samsung-s6e3ha6.c
@@ -0,0 +1,289 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Samsung S6E3HA6 command-mode AMOLED panel used by Galaxy S8 (dreamlte).
+ *
+ * The basic power-on sequence and the DSC PPS were taken from Samsung's
+ * Exynos8895 panel driver.  PMIC-controlled panel rails are already enabled
+ * by the boot firmware and cannot be controlled until the S2MPS17 driver is
+ * available, so this driver deliberately owns only the reset GPIO.
+ */
+
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+
+#include <video/mipi_display.h>
+
+#include <drm/display/drm_dsc.h>
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_panel.h>
+#include <drm/drm_probe_helper.h>
+
+struct s6e3ha6 {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct gpio_desc *reset_gpio;
+	struct drm_dsc_config dsc;
+};
+
+static const struct drm_display_mode s6e3ha6_mode = {
+	.clock = (1440 + 2 + 2 + 2) * (2960 + 15 + 3 + 1) * 60 / 1000,
+	.hdisplay = 1440,
+	.hsync_start = 1442,
+	.hsync_end = 1444,
+	.htotal = 1446,
+	.vdisplay = 2960,
+	.vsync_start = 2975,
+	.vsync_end = 2978,
+	.vtotal = 2979,
+	.width_mm = 65,
+	.height_mm = 133,
+	.type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED,
+};
+
+/* 1440x2960, two 720x40 DSC slices: vendor PPS bytes 0 through 127. */
+static const u8 s6e3ha6_pps[128] = {
+	0x11, 0x00, 0x00, 0x89, 0x30, 0x80, 0x0b, 0x90,
+	0x05, 0xa0, 0x00, 0x28, 0x02, 0xd0, 0x02, 0xd0,
+	0x02, 0x00, 0x02, 0x68, 0x00, 0x20, 0x04, 0x6c,
+	0x00, 0x0a, 0x00, 0x0c, 0x02, 0x77, 0x01, 0xe9,
+	0x18, 0x00, 0x10, 0xf0, 0x03, 0x0c, 0x20, 0x00,
+	0x06, 0x0b, 0x0b, 0x33, 0x0e, 0x1c, 0x2a, 0x38,
+	0x46, 0x54, 0x62, 0x69, 0x70, 0x77, 0x79, 0x7b,
+	0x7d, 0x7e, 0x01, 0x02, 0x01, 0x00, 0x09, 0x40,
+	0x09, 0xbe, 0x19, 0xfc, 0x19, 0xfa, 0x19, 0xf8,
+	0x1a, 0x38, 0x1a, 0x78, 0x1a, 0xb6, 0x2a, 0xf6,
+	0x2b, 0x34, 0x2b, 0x74, 0x3b, 0x74, 0x6b, 0xf4,
+	0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+	0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+	0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+	0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+	0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+};
+
+static inline struct s6e3ha6 *panel_to_s6e3ha6(struct drm_panel *panel)
+{
+	return container_of(panel, struct s6e3ha6, panel);
+}
+
+static void s6e3ha6_reset(struct s6e3ha6 *ctx)
+{
+	/* reset-gpios is active-low; this is the vendor 9ms/1ms/9ms pulse. */
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(9000, 10000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	usleep_range(1000, 2000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(9000, 10000);
+}
+
+static int s6e3ha6_prepare(struct drm_panel *panel)
+{
+	struct s6e3ha6 *ctx = panel_to_s6e3ha6(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+	struct drm_dsc_picture_parameter_set pps;
+
+	BUILD_BUG_ON(sizeof(pps) != sizeof(s6e3ha6_pps));
+	s6e3ha6_reset(ctx);
+	usleep_range(5000, 6000);
+
+	/* Enable the vendor command level, configure DSC, then wake the panel. */
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x9f, 0xa5, 0xa5);
+	memcpy(&pps, s6e3ha6_pps, sizeof(pps));
+	mipi_dsi_compression_mode_multi(&dsi_ctx, true);
+	mipi_dsi_picture_parameter_set_multi(&dsi_ctx, &pps);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x9f, 0x5a, 0x5a);
+	mipi_dsi_dcs_exit_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 10);
+
+	/* Native 1440x2960 scaler and address window. */
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xba, 0x01, 0x02, 0x06, 0x08,
+				     0x08, 0x1e, 0x03);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x2a, 0x00, 0x00, 0x05, 0x9f);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x2b, 0x00, 0x00, 0x0b, 0x8f);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xfc, 0x5a, 0x5a);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x05);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xff, 0x01);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x07);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf2, 0x3c, 0xd0);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xfc, 0xa5, 0xa5);
+
+	/* Full panel area, TE and the calibrated 898 MHz FFC parameters. */
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x9f, 0xa5, 0xa5);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x1a, 0x1f, 0x00, 0x00, 0x00, 0x00);
+	mipi_dsi_dcs_set_tear_on_multi(&dsi_ctx, MIPI_DSI_DCS_TEAR_MODE_VBLANK);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x9f, 0x5a, 0x5a);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xed, 0x4c);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xc5, 0x0d, 0x08, 0x40, 0x19,
+				     0xb7, 0x07, 0x1f, 0x81, 0x25, 0xce, 0x79,
+				     0x77, 0x73, 0x00, 0xff, 0x78, 0x8f, 0x00,
+				     0x00);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb9, 0x01, 0x0b, 0x91, 0x00,
+					     0x09);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x03);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf6, 0x53);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x08);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf6, 0x80);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+
+	/* Vendor baseline brightness sequence; calibrated tuning can follow. */
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xca,
+				     0x01, 0x00, 0x01, 0x00, 0x01, 0x00,
+				     0x80, 0x80, 0x80, 0x80, 0x80, 0x80,
+				     0x80, 0x80, 0x80, 0x80, 0x80, 0x80,
+				     0x80, 0x80, 0x80, 0x80, 0x80, 0x80,
+				     0x80, 0x80, 0x80, 0x80, 0x80, 0x80,
+				     0x80, 0x80, 0x80, 0x00, 0x00);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb1, 0x00, 0x0c);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb5,
+				     0x19, 0xdc, 0x0a, 0x01, 0x01, 0x34,
+				     0x67, 0x9a, 0xcd, 0x01, 0x22, 0x33,
+				     0x44, 0x00, 0x00, 0x08, 0x88, 0xff,
+				     0x0f, 0x01, 0x11, 0x11, 0x10, 0x0c);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf4, 0xeb, 0x17);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb4, 0x00, 0x44, 0x99,
+				     0x00, 0x00, 0x0a, 0x00);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x55, 0x00);
+	/* DREAM2_A3_SA IRC table; the DA table belongs to another panel variant. */
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb8,
+				     0x0d, 0xf0, 0x2d, 0x30, 0x3c, 0xbe,
+				     0x33, 0x69, 0x12, 0x7a, 0xe0, 0x78,
+				     0x78, 0x78, 0x28, 0x28, 0x28, 0x28,
+				     0x28, 0x28);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf7, 0x03);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+
+	if (dsi_ctx.accum_err)
+		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+
+	return dsi_ctx.accum_err;
+}
+
+static int s6e3ha6_enable(struct drm_panel *panel)
+{
+	struct s6e3ha6 *ctx = panel_to_s6e3ha6(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x9f, 0xa5, 0xa5);
+	mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x9f, 0x5a, 0x5a);
+
+	return dsi_ctx.accum_err;
+}
+
+static int s6e3ha6_disable(struct drm_panel *panel)
+{
+	struct s6e3ha6 *ctx = panel_to_s6e3ha6(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x9f, 0xa5, 0xa5);
+	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x9f, 0x5a, 0x5a);
+
+	return dsi_ctx.accum_err;
+}
+
+static int s6e3ha6_unprepare(struct drm_panel *panel)
+{
+	struct s6e3ha6 *ctx = panel_to_s6e3ha6(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x9f, 0xa5, 0xa5);
+	mipi_dsi_dcs_enter_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x9f, 0x5a, 0x5a);
+	mipi_dsi_msleep(&dsi_ctx, 120);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+
+	return dsi_ctx.accum_err;
+}
+
+static int s6e3ha6_get_modes(struct drm_panel *panel,
+				     struct drm_connector *connector)
+{
+	return drm_connector_helper_get_modes_fixed(connector, &s6e3ha6_mode);
+}
+
+static const struct drm_panel_funcs s6e3ha6_panel_funcs = {
+	.prepare = s6e3ha6_prepare,
+	.unprepare = s6e3ha6_unprepare,
+	.enable = s6e3ha6_enable,
+	.disable = s6e3ha6_disable,
+	.get_modes = s6e3ha6_get_modes,
+};
+
+static int s6e3ha6_probe(struct mipi_dsi_device *dsi)
+{
+	struct s6e3ha6 *ctx;
+	int ret;
+
+	ctx = devm_drm_panel_alloc(&dsi->dev, __typeof(*ctx), panel,
+				   &s6e3ha6_panel_funcs, DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	ctx->reset_gpio = devm_gpiod_get(&dsi->dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(ctx->reset_gpio))
+		return dev_err_probe(&dsi->dev, PTR_ERR(ctx->reset_gpio),
+				     "failed to get reset GPIO\n");
+
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->mode_flags = MIPI_DSI_MODE_LPM |
+			  MIPI_DSI_CLOCK_NON_CONTINUOUS;
+	ctx->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	ctx->dsc.dsc_version_major = 1;
+	ctx->dsc.dsc_version_minor = 1;
+	ctx->dsc.slice_height = 40;
+	ctx->dsc.slice_width = 720;
+	ctx->dsc.slice_count = 2;
+	ctx->dsc.bits_per_component = 8;
+	ctx->dsc.bits_per_pixel = 8 << 4;
+	ctx->dsc.block_pred_enable = true;
+	dsi->dsc = &ctx->dsc;
+
+	ctx->panel.prepare_prev_first = true;
+	drm_panel_add(&ctx->panel);
+	ret = mipi_dsi_attach(dsi);
+	if (ret) {
+		drm_panel_remove(&ctx->panel);
+		return ret;
+	}
+
+	return 0;
+}
+
+static void s6e3ha6_remove(struct mipi_dsi_device *dsi)
+{
+	struct s6e3ha6 *ctx = mipi_dsi_get_drvdata(dsi);
+	int ret;
+
+	ret = mipi_dsi_detach(dsi);
+	if (ret < 0)
+		dev_err(&dsi->dev, "failed to detach from DSI host: %d\n", ret);
+	drm_panel_remove(&ctx->panel);
+}
+
+static const struct of_device_id s6e3ha6_of_match[] = {
+	{ .compatible = "samsung,s6e3ha6" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, s6e3ha6_of_match);
+
+static struct mipi_dsi_driver s6e3ha6_driver = {
+	.driver = {
+		.name = "panel-samsung-s6e3ha6",
+		.of_match_table = s6e3ha6_of_match,
+	},
+	.probe = s6e3ha6_probe,
+	.remove = s6e3ha6_remove,
+};
+module_mipi_dsi_driver(s6e3ha6_driver);
+
+MODULE_DESCRIPTION("Samsung S6E3HA6 AMOLED panel");
+MODULE_LICENSE("GPL");
