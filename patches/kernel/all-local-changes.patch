+
+		reg = readl(refclk + drv_data->refclk_sel_offset);
+		reg &= ~drv_data->refclk_sel_mask;
+		reg |= drv_data->refclk_sel_value;
+		writel(reg, refclk + drv_data->refclk_sel_offset);
+		dev_info(dev, "PHY refclk selector now %#x\n",
+			 readl(refclk + drv_data->refclk_sel_offset));
+	}
+
+	if (drv_data->has_version_reg) {
+		u32 version = readl(phy_drd->reg_phy);
+
+		if (version) {
+			dev_info(dev, "USBCON version %04x, registers shifted by 4\n",
+				 version);
+			phy_drd->reg_phy += 4;
+		}
+	}
+
 	/*
 	 * USB32DRD 4nm controller implements Synopsys eUSB2.0 PHY
 	 * and Synopsys SS/USBDP COMBOPHY, managed by external code.
diff --git a/drivers/phy/samsung/phy-exynos8895-ufs.c b/drivers/phy/samsung/phy-exynos8895-ufs.c
new file mode 100644
index 000000000..c5a46cf86
--- /dev/null
+++ b/drivers/phy/samsung/phy-exynos8895-ufs.c
@@ -0,0 +1,174 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * UFS PHY driver data for Samsung Exynos8895 SoC
+ *
+ * Значения взяты из вендорского ядра Samsung для universal8895
+ * (android_kernel_samsung_universal8895), где вся калибровка PMA лежит не в
+ * коде, а прямо в dts — в узле ufs@0x11120000, свойства phy-init,
+ * calib-of-hs-rate-b и post-calib-of-hs-rate-b. Записи с типом PHY_PMA_COMN
+ * и PHY_PMA_TRSV — это и есть наша таблица.
+ *
+ * Адресация PMA у Exynos8895 отличается от Exynos7420, и это важно:
+ *
+ *   downstream ufs-exynos.h, ветка !EXYNOS7420 && !EXYNOS8890:
+ *     PHY_PMA_COMN_ADDR(reg)       (reg)
+ *     PHY_PMA_TRSV_ADDR(reg, lane) ((reg) + (0x140 * (lane)))
+ *
+ * то есть в вендорской таблице смещения уже байтовые, а шаг между линиями
+ * 0x140 байт. Здесь же макросы phy-samsung-ufs.h принимают НОМЕР регистра и
+ * сами домножают на 4 (PHY_APB_ADDR). Поэтому все смещения ниже поделены на
+ * 4, а шаг линии равен 0x140 / 4 = 0x50. Байтовый адрес из даунстрима указан
+ * в комментарии к каждой строке, чтобы сверка была механической.
+ *
+ * Блок COMN занимает 0x000..0x0BF, TRSV линии 0 начинается с 0x0C0, линии 1
+ * с 0x200 — отсюда сходятся вендорские подписи вида "TRSVx_14(0x110/0x250)".
+ */
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+
+#include "phy-samsung-ufs.h"
+
+/*
+ * Регистр изоляции PHY в PMU. У Exynos7420 это 0x0720, у нас 0x0724 —
+ * подтверждено даунстримом дважды: литералом 0x16480724 в подузле
+ * ufs-phy-sys узла ufs, и местом записи exynos_ufs_ctrl_phy_pwr(), где в
+ * этот регистр пишется просто 1, чтобы снять изоляцию.
+ */
+#define EXYNOS8895_EMBEDDED_COMBO_PHY_CTRL	0x0724
+#define EXYNOS8895_EMBEDDED_COMBO_PHY_CTRL_MASK	0x1
+#define EXYNOS8895_EMBEDDED_COMBO_PHY_CTRL_EN	BIT(0)
+
+/* шаг между линиями TRSV: 0x140 байт = 0x50 регистров */
+#define PHY_EXYNOS8895_LANE_OFFSET		0x50
+
+/* монитор захвата CDR, байтовое смещение 0x1FC у линии 0 */
+#define EXYNOS8895_PHY_CDR_LOCK_STATUS		0x7F
+#define EXYNOS8895_PHY_CDR_LOCK_DONE		BIT(0)
+
+/* пауза COMMON_WAIT из хвоста вендорской phy-init, мкс */
+#define EXYNOS8895_PHY_CAL_WAIT_US		200
+
+#define PHY_TRSV_REG_CFG_E8895(o, v, d)	\
+	PHY_TRSV_REG_CFG_OFFSET(o, v, d, PHY_EXYNOS8895_LANE_OFFSET)
+
+/*
+ * Калибровка перед стартом линка (вендорское свойство phy-init, часть
+ * PHY_PMA_*). Обрамление 0x8C: 0x80 -> настройка -> 0xC0 -> 0x00 — это
+ * вендорская последовательность применения, её порядок значим.
+ */
+static const struct samsung_ufs_phy_cfg exynos8895_pre_init_cfg[] = {
+	PHY_COMN_REG_CFG(0x023, 0x80, PWR_MODE_ANY),	/* 0x08C */
+	/* CMN_REG1D: источник PWM-такта, 0x10 = refclk (0x20 = внутренний OSC) */
+	PHY_COMN_REG_CFG(0x01d, 0x10, PWR_MODE_ANY),	/* 0x074 */
+	PHY_TRSV_REG_CFG_E8895(0x044, 0xb5, PWR_MODE_ANY),	/* 0x110 */
+	PHY_TRSV_REG_CFG_E8895(0x04d, 0x43, PWR_MODE_ANY),	/* 0x134 */
+	PHY_TRSV_REG_CFG_E8895(0x05b, 0x20, PWR_MODE_ANY),	/* 0x16C */
+	PHY_TRSV_REG_CFG_E8895(0x05e, 0xc0, PWR_MODE_ANY),	/* 0x178 */
+	PHY_TRSV_REG_CFG_E8895(0x038, 0x12, PWR_MODE_ANY),	/* 0x0E0 */
+	PHY_TRSV_REG_CFG_E8895(0x059, 0x58, PWR_MODE_ANY),	/* 0x164 */
+	PHY_COMN_REG_CFG(0x023, 0xc0, PWR_MODE_ANY),	/* 0x08C */
+	PHY_COMN_REG_CFG(0x023, 0x00, PWR_MODE_ANY),	/* 0x08C */
+	END_UFS_PHY_CFG,
+};
+
+/*
+ * Калибровка под HS (вендорское calib-of-hs-rate-b, часть PHY_PMA_TRSV).
+ *
+ * У даунстрима записи 0x128/0x12C/0x134 расписаны отдельно для G1/G2/G3, а
+ * в mainline поле .desc сейчас не фильтруется вовсе (samsung_ufs_phy_calibrate
+ * применяет таблицу целиком), поэтому оставлены только значения для G3 —
+ * именно эту передачу и просит dts даунстрима (pmd-attr-gear = 3,
+ * hs-series = HS_rate_b). Если понадобится G1/G2, фильтрацию по .desc
+ * придётся сначала вернуть в phy-samsung-ufs.c.
+ *
+ * Таблицы rate-a и rate-b в даунстриме побайтово совпадают, так что эта
+ * годится для обеих серий.
+ */
+static const struct samsung_ufs_phy_cfg exynos8895_pre_pwr_hs_cfg[] = {
+	PHY_TRSV_REG_CFG_E8895(0x032, 0xbc, PWR_MODE_HS_ANY),	/* 0x0C8 */
+	/* TX_SLEW_PREEMP_EN_CTRL_EN = 1 */
+	PHY_TRSV_REG_CFG_E8895(0x03c, 0x7f, PWR_MODE_HS_ANY),	/* 0x0F0 */
+	/* TX_AMPL_CNTR_EN = 1 */
+	PHY_TRSV_REG_CFG_E8895(0x048, 0xc0, PWR_MODE_HS_ANY),	/* 0x120 */
+	/* TX_AMPL_CTRL = 0 (G3A/B) */
+	PHY_TRSV_REG_CFG_E8895(0x04a, 0x00, PWR_MODE_HS_G3_ANY),	/* 0x128 */
+	/* TX_PREEMP_CTRL = 0 dB */
+	PHY_TRSV_REG_CFG_E8895(0x04b, 0x00, PWR_MODE_HS_ANY),	/* 0x12C */
+	/* TX_AUX_CAP_CTRL = 3b'110 (G3A/B) */
+	PHY_TRSV_REG_CFG_E8895(0x04d, 0x63, PWR_MODE_HS_G3_ANY),	/* 0x134 */
+	PHY_TRSV_REG_CFG_E8895(0x042, 0x5d, PWR_MODE_HS_ANY),	/* 0x108 */
+	PHY_TRSV_REG_CFG_E8895(0x043, 0x90, PWR_MODE_HS_ANY),	/* 0x10C */
+	END_UFS_PHY_CFG,
+};
+
+static const struct samsung_ufs_phy_cfg *exynos8895_ufs_phy_cfgs[CFG_TAG_MAX] = {
+	[CFG_PRE_INIT]		= exynos8895_pre_init_cfg,
+	[CFG_PRE_PWR_HS]	= exynos8895_pre_pwr_hs_cfg,
+};
+
+/*
+ * Один такт, а не четыре. У Exynos7420 PHY получает tx0/rx0/rx1_symbol_clk
+ * отдельными гейтами; у Exynos8895 таких гейтов в даунстриме нет вообще —
+ * узлу ufs отданы всего два клока (aclk и unipro), а PHY тактируется от
+ * опорного через мультиплексор внутри HCI (HCI_MPHY_REFCLK_SEL). Все SoC
+ * Samsung новее 7420 (autov9, autov920, gs101) объявляют ровно один ref_clk.
+ */
+static const char * const exynos8895_ufs_phy_clks[] = {
+	"ref_clk",
+};
+
+/*
+ * Хвост вендорской phy-init: <0x00 0xC8 PMD_ALL COMMON_WAIT>, то есть
+ * udelay(200) сразу после таблицы. Отдельного типа "подождать" в mainline
+ * нет, зато есть ровно подходящий по месту вызова хук wait_for_cal — он
+ * дёргается сразу после применения CFG_PRE_INIT.
+ */
+static int exynos8895_phy_wait_for_calibration(struct phy *phy, u8 lane)
+{
+	udelay(EXYNOS8895_PHY_CAL_WAIT_US);
+
+	return 0;
+}
+
+/*
+ * Вендорское post-calib-of-hs-rate-b: <0x1fc 0x01 PMD_HS PHY_CDR_WAIT>.
+ * Даунстрим ждёт до 100 мс, опрашивая бит 0 регистра TRSV по байтовому
+ * смещению 0x1FC (линия 0) / 0x33C (линия 1).
+ *
+ * Штатный samsung_ufs_phy_wait_for_lock_acq здесь не годится: он проверяет
+ * ещё и PLL lock по общему для exynos7 адресу, которого у нас нет.
+ */
+static int exynos8895_phy_wait_for_cdr_lock(struct phy *phy, u8 lane)
+{
+	struct samsung_ufs_phy *ufs_phy = get_samsung_ufs_phy(phy);
+	const unsigned int timeout_us = 100000;
+	const unsigned int sleep_us = 10;
+	u32 off;
+	u32 val;
+	int err;
+
+	off = PHY_APB_ADDR(EXYNOS8895_PHY_CDR_LOCK_STATUS +
+			   lane * PHY_EXYNOS8895_LANE_OFFSET);
+
+	err = readl_poll_timeout(ufs_phy->reg_pma + off, val,
+				 (val & EXYNOS8895_PHY_CDR_LOCK_DONE),
+				 sleep_us, timeout_us);
+	if (err)
+		dev_err(ufs_phy->dev, "failed to get cdr lock %d\n", err);
+
+	return err;
+}
+
+const struct samsung_ufs_phy_drvdata exynos8895_ufs_phy = {
+	.cfgs = exynos8895_ufs_phy_cfgs,
+	.isol = {
+		.offset = EXYNOS8895_EMBEDDED_COMBO_PHY_CTRL,
+		.mask = EXYNOS8895_EMBEDDED_COMBO_PHY_CTRL_MASK,
+		.en = EXYNOS8895_EMBEDDED_COMBO_PHY_CTRL_EN,
+	},
+	.clk_list = exynos8895_ufs_phy_clks,
+	.num_clks = ARRAY_SIZE(exynos8895_ufs_phy_clks),
+	.wait_for_cal = exynos8895_phy_wait_for_calibration,
+	.wait_for_cdr = exynos8895_phy_wait_for_cdr_lock,
+};
diff --git a/drivers/phy/samsung/phy-exynos8895-usbdrd.c b/drivers/phy/samsung/phy-exynos8895-usbdrd.c
new file mode 100644
index 000000000..051b6c837
--- /dev/null
+++ b/drivers/phy/samsung/phy-exynos8895-usbdrd.c
@@ -0,0 +1,420 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Samsung Exynos8895 USB DRD PHY driver
+ *
+ * The register layout matches the Exynos5433/7 USBCON block that
+ * phy-exynos5-usbdrd.c drives, but the bring-up sequence does not, and
+ * patching that driver one register at a time did not converge. Three
+ * separate vendor-only steps were tried there and none of them was
+ * enough on its own, so this is a faithful port of the vendor sequence
+ * instead (samsung_exynos_cal_usb3phy_enable() with version
+ * EXYNOS_USBCON_VER_01_1_1).
+ *
+ * The things this does that the generic driver never does:
+ *
+ *  - the block carries a version register at offset 0, which shifts the
+ *    whole register map up by one word;
+ *  - the Q-Channel handshake has to be switched off, otherwise the block
+ *    quiesces itself, its clocks stop and every controller command times
+ *    out with "failed to enable ep0out";
+ *  - there are TWO PHY register windows. Both must be taken out of
+ *    power-down together, given a millisecond, and only then may the
+ *    unused one be powered down again;
+ *  - the UTMI clock source is selected in PHYPIPE;
+ *  - the reference clock source is picked by a register outside the PHY
+ *    block entirely.
+ */
+
+#include <linux/bitfield.h>
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/mfd/syscon.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/phy/phy.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+
+#define EXYNOS8895_DRD_LINKSYSTEM		0x04
+#define LINKSYSTEM_LINK_SW_RESET		BIT(28)
+#define LINKSYSTEM_XHCI_VERSION_CONTROL		BIT(27)
+#define LINKSYSTEM_FORCE_VBUSVALID		BIT(8)
+#define LINKSYSTEM_FORCE_BVALID			BIT(7)
+#define LINKSYSTEM_FLADJ			GENMASK(6, 1)
+
+#define EXYNOS8895_DRD_PHYUTMI			0x08
+#define PHYUTMI_VBUSVLDEXTSEL			BIT(10)
+#define PHYUTMI_VBUSVLDEXT			BIT(9)
+#define PHYUTMI_OTGDISABLE			BIT(6)
+#define PHYUTMI_DRVVBUS				BIT(4)
+#define PHYUTMI_DPPULLDOWN			BIT(3)
+#define PHYUTMI_DMPULLDOWN			BIT(2)
+#define PHYUTMI_FORCESUSPEND			BIT(1)
+#define PHYUTMI_FORCESLEEP			BIT(0)
+
+#define EXYNOS8895_DRD_PHYPIPE			0x0c
+#define PHYPIPE_PHY_CLOCK_SEL			BIT(4)
+
+#define EXYNOS8895_DRD_PHYCLKRST		0x10
+#define PHYCLKRST_EN_UTMISUSPEND		BIT(31)
+#define PHYCLKRST_SSC_REFCLKSEL			GENMASK(30, 23)
+#define PHYCLKRST_SSC_RANGE			GENMASK(22, 21)
+#define PHYCLKRST_SSC_EN			BIT(20)
+#define PHYCLKRST_REF_SSP_EN			BIT(19)
+#define PHYCLKRST_REF_CLKDIV2			BIT(18)
+#define PHYCLKRST_MPLL_MULTIPLIER		GENMASK(17, 11)
+#define PHYCLKRST_FSEL				GENMASK(10, 5)
+#define PHYCLKRST_RETENABLEN			BIT(4)
+#define PHYCLKRST_REFCLKSEL			GENMASK(3, 2)
+#define PHYCLKRST_PORTRESET			BIT(1)
+#define PHYCLKRST_COMMONONN			BIT(0)
+
+#define EXYNOS8895_DRD_PHYREG0			0x14
+#define EXYNOS8895_DRD_PHYPARAM0		0x1c
+#define PHYPARAM0_REF_USE_PAD			BIT(31)
+
+#define EXYNOS8895_DRD_PHYTEST			0x28
+#define PHYTEST_POWERDOWN_SSP			BIT(3)
+#define PHYTEST_POWERDOWN_HSP			BIT(2)
+
+#define EXYNOS8895_DRD_PHYRESUME		0x34
+#define PHYRESUME_DIS_LINKGATE_QACT		BIT(13)
+#define PHYRESUME_DIS_ID0_QACT			BIT(12)
+#define PHYRESUME_DIS_VBUSVALID_QACT		BIT(11)
+#define PHYRESUME_DIS_BVALID_QACT		BIT(10)
+#define PHYRESUME_FORCE_QACT			BIT(9)
+
+#define EXYNOS8895_DRD_LINKPORT			0x44
+#define LINKPORT_HOST_U3_PORT_DISABLE		BIT(8)
+#define LINKPORT_HOST_PORT_OVCR_U3_SEL		BIT(3)
+#define LINKPORT_HOST_PORT_OVCR_U2_SEL		BIT(2)
+
+/* PMU register that isolates the PHY from the rest of the SoC. */
+#define EXYNOS8895_USBDRD_PHY_CONTROL		0x704
+#define PHY_CONTROL_ENABLE			BIT(0)
+
+/*
+ * Reference clock source selector. It sits in a register window of its
+ * own, outside the PHY block, and the vendor drives it from a separate
+ * "usbphy-refclk" DT subnode.
+ */
+#define EXYNOS8895_REFCLK_SEL_OFFSET		0x0c
+#define EXYNOS8895_REFCLK_SEL_BIT		BIT(24)
+
+/* The vendor calls this source CLKCORE; the encoding is 0x2. */
+#define EXYNOS8895_REFCLKSEL_CLKCORE		0x2
+
+/* FSEL encoding for the 26 MHz crystal this SoC is fitted with. */
+#define EXYNOS8895_FSEL_26MHZ			0x06
+
+struct exynos8895_usbdrd {
+	struct device *dev;
+	void __iomem *reg_phy;		/* first PHY window  */
+	void __iomem *reg_phy2;		/* second PHY window */
+	void __iomem *reg_refclk;
+	struct regmap *pmu;
+	struct clk *bus_clk;
+	struct clk *ref_clk;
+	struct phy *phy;
+};
+
+static void exynos8895_isolate(struct exynos8895_usbdrd *drd, bool isolate)
+{
+	regmap_update_bits(drd->pmu, EXYNOS8895_USBDRD_PHY_CONTROL,
+			   PHY_CONTROL_ENABLE, isolate ? 0 : PHY_CONTROL_ENABLE);
+}
+
+/*
+ * Left to itself the block answers the Q-Channel handshake, quiesces and
+ * stops its clocks. Every ordering detail here is the vendor's: the
+ * disable bits have to land, and settle, before Q-active is forced.
+ */
+static void exynos8895_force_qact(struct exynos8895_usbdrd *drd)
+{
+	u32 reg;
+
+	reg = readl(drd->reg_phy + EXYNOS8895_DRD_PHYRESUME);
+	reg |= PHYRESUME_DIS_ID0_QACT | PHYRESUME_DIS_VBUSVALID_QACT |
+	       PHYRESUME_DIS_BVALID_QACT | PHYRESUME_DIS_LINKGATE_QACT;
+	reg &= ~PHYRESUME_FORCE_QACT;
+	udelay(500);
+	writel(reg, drd->reg_phy + EXYNOS8895_DRD_PHYRESUME);
+	udelay(500);
+
+	reg = readl(drd->reg_phy + EXYNOS8895_DRD_PHYRESUME);
+	reg |= PHYRESUME_FORCE_QACT;
+	udelay(500);
+	writel(reg, drd->reg_phy + EXYNOS8895_DRD_PHYRESUME);
+
+	reg = readl(drd->reg_phy + EXYNOS8895_DRD_LINKSYSTEM);
+	writel(reg | LINKSYSTEM_LINK_SW_RESET,
+	       drd->reg_phy + EXYNOS8895_DRD_LINKSYSTEM);
+	udelay(10);
+	writel(reg & ~LINKSYSTEM_LINK_SW_RESET,
+	       drd->reg_phy + EXYNOS8895_DRD_LINKSYSTEM);
+}
+
+/*
+ * Both windows come out of power-down together and only then, after a
+ * millisecond, does the unused one go back down. Powering up just the
+ * window we use is not the same thing and does not work.
+ */
+static void exynos8895_power_up_phys(struct exynos8895_usbdrd *drd)
+{
+	u32 reg, reg2;
+
+	reg = readl(drd->reg_phy + EXYNOS8895_DRD_PHYTEST);
+	reg &= ~(PHYTEST_POWERDOWN_HSP | PHYTEST_POWERDOWN_SSP);
+	writel(reg, drd->reg_phy + EXYNOS8895_DRD_PHYTEST);
+
+	reg2 = readl(drd->reg_phy2 + EXYNOS8895_DRD_PHYTEST);
+	reg2 &= ~(PHYTEST_POWERDOWN_HSP | PHYTEST_POWERDOWN_SSP);
+	writel(reg2, drd->reg_phy2 + EXYNOS8895_DRD_PHYTEST);
+
+	udelay(1000);
+
+	/* We use port 0, so the second PHY goes back to sleep. */
+	reg2 |= PHYTEST_POWERDOWN_SSP | PHYTEST_POWERDOWN_HSP;
+	writel(reg2, drd->reg_phy2 + EXYNOS8895_DRD_PHYTEST);
+}
+
+static int exynos8895_usbdrd_init(struct phy *phy)
+{
+	struct exynos8895_usbdrd *drd = phy_get_drvdata(phy);
+	u32 reg, phyreg0;
+	int ret;
+
+	ret = clk_prepare_enable(drd->bus_clk);
+	if (ret)
+		return ret;
+
+	exynos8895_force_qact(drd);
+
+	reg = readl(drd->reg_phy + EXYNOS8895_DRD_PHYCLKRST);
+
+	/* Hold the port in reset while the clocking is set up. */
+	reg |= PHYCLKRST_PORTRESET;
+
+	reg &= ~PHYCLKRST_REFCLKSEL;
+	reg |= FIELD_PREP(PHYCLKRST_REFCLKSEL, EXYNOS8895_REFCLKSEL_CLKCORE);
+
+	reg &= ~PHYCLKRST_FSEL;
+	reg |= FIELD_PREP(PHYCLKRST_FSEL, EXYNOS8895_FSEL_26MHZ);
+
+	/* Common block stays alive in suspend, and the link does not gate it. */
+	reg &= ~PHYCLKRST_COMMONONN;
+	reg &= ~PHYCLKRST_EN_UTMISUSPEND;
+
+	/* Normal (not retention) digital supply mode, and the SS ref clock. */
+	reg |= PHYCLKRST_RETENABLEN;
+	reg |= PHYCLKRST_REF_SSP_EN;
+
+	/* Spread spectrum on, default range, as the vendor leaves it. */
+	reg |= PHYCLKRST_SSC_EN;
+	reg &= ~PHYCLKRST_SSC_RANGE;
+
+	phyreg0 = readl(drd->reg_phy + EXYNOS8895_DRD_PHYREG0);
+
+	/* The reference comes from inside the SoC, not off a pad. */
+	writel(readl(drd->reg_phy + EXYNOS8895_DRD_PHYPARAM0) &
+	       ~PHYPARAM0_REF_USE_PAD,
+	       drd->reg_phy + EXYNOS8895_DRD_PHYPARAM0);
+
+	/* UTMI runs off the free-running clock rather than the PHY clock. */
+	writel(readl(drd->reg_phy + EXYNOS8895_DRD_PHYPIPE) |
+	       PHYPIPE_PHY_CLOCK_SEL,
+	       drd->reg_phy + EXYNOS8895_DRD_PHYPIPE);
+
+	writel(phyreg0, drd->reg_phy + EXYNOS8895_DRD_PHYREG0);
+
+	writel(reg, drd->reg_phy + EXYNOS8895_DRD_PHYCLKRST);
+	udelay(10);
+	reg &= ~PHYCLKRST_PORTRESET;
+	writel(reg, drd->reg_phy + EXYNOS8895_DRD_PHYCLKRST);
+
+	exynos8895_power_up_phys(drd);
+	udelay(500);
+
+	/*
+	 * There is no VBUS sense pad wired up on this board, so the link is
+	 * told the bus is valid and the PHY takes the session valid signal
+	 * from the register rather than from the (absent) comparator.
+	 */
+	reg = readl(drd->reg_phy + EXYNOS8895_DRD_LINKSYSTEM);
+	reg |= LINKSYSTEM_XHCI_VERSION_CONTROL;
+	reg &= ~LINKSYSTEM_FLADJ;
+	reg |= FIELD_PREP(LINKSYSTEM_FLADJ, 0x20);
+	reg |= LINKSYSTEM_FORCE_BVALID | LINKSYSTEM_FORCE_VBUSVALID;
+	writel(reg, drd->reg_phy + EXYNOS8895_DRD_LINKSYSTEM);
+
+	reg = readl(drd->reg_phy + EXYNOS8895_DRD_PHYUTMI);
+	reg &= ~(PHYUTMI_FORCESLEEP | PHYUTMI_FORCESUSPEND);
+	reg &= ~(PHYUTMI_DMPULLDOWN | PHYUTMI_DPPULLDOWN);
+	reg |= PHYUTMI_VBUSVLDEXTSEL | PHYUTMI_VBUSVLDEXT;
+	/* Device mode: no OTG block, and we never drive VBUS ourselves. */
+	reg &= ~PHYUTMI_DRVVBUS;
+	reg |= PHYUTMI_OTGDISABLE;
+	writel(reg, drd->reg_phy + EXYNOS8895_DRD_PHYUTMI);
+
+	reg = readl(drd->reg_phy + EXYNOS8895_DRD_LINKPORT);
+	reg |= LINKPORT_HOST_PORT_OVCR_U3_SEL | LINKPORT_HOST_PORT_OVCR_U2_SEL;
+	reg &= ~LINKPORT_HOST_U3_PORT_DISABLE;
+	writel(reg, drd->reg_phy + EXYNOS8895_DRD_LINKPORT);
+
+	return 0;
+}
+
+static int exynos8895_usbdrd_exit(struct phy *phy)
+{
+	struct exynos8895_usbdrd *drd = phy_get_drvdata(phy);
+	u32 reg;
+
+	reg = readl(drd->reg_phy + EXYNOS8895_DRD_PHYUTMI);
+	reg |= PHYUTMI_FORCESUSPEND | PHYUTMI_FORCESLEEP;
+	writel(reg, drd->reg_phy + EXYNOS8895_DRD_PHYUTMI);
+
+	reg = readl(drd->reg_phy + EXYNOS8895_DRD_PHYTEST);
+	reg |= PHYTEST_POWERDOWN_HSP | PHYTEST_POWERDOWN_SSP;
+	writel(reg, drd->reg_phy + EXYNOS8895_DRD_PHYTEST);
+
+	clk_disable_unprepare(drd->bus_clk);
+
+	return 0;
+}
+
+static int exynos8895_usbdrd_power_on(struct phy *phy)
+{
+	struct exynos8895_usbdrd *drd = phy_get_drvdata(phy);
+	int ret;
+
+	ret = clk_prepare_enable(drd->ref_clk);
+	if (ret)
+		return ret;
+
+	exynos8895_isolate(drd, false);
+
+	return 0;
+}
+
+static int exynos8895_usbdrd_power_off(struct phy *phy)
+{
+	struct exynos8895_usbdrd *drd = phy_get_drvdata(phy);
+
+	exynos8895_isolate(drd, true);
+	clk_disable_unprepare(drd->ref_clk);
+
+	return 0;
+}
+
+static const struct phy_ops exynos8895_usbdrd_ops = {
+	.init		= exynos8895_usbdrd_init,
+	.exit		= exynos8895_usbdrd_exit,
+	.power_on	= exynos8895_usbdrd_power_on,
+	.power_off	= exynos8895_usbdrd_power_off,
+	.owner		= THIS_MODULE,
+};
+
+static struct phy *exynos8895_usbdrd_xlate(struct device *dev,
+					   const struct of_phandle_args *args)
+{
+	struct exynos8895_usbdrd *drd = dev_get_drvdata(dev);
+
+	/*
+	 * Only the USB 2.0 side is brought up here, and both cells map to
+	 * it. USB 3.0 needs the PIPE3 block, which has a calibration table
+	 * of its own and buys nothing for a network gadget.
+	 */
+	return drd->phy;
+}
+
+static int exynos8895_usbdrd_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct exynos8895_usbdrd *drd;
+	struct phy_provider *provider;
+	u32 version, reg;
+
+	drd = devm_kzalloc(dev, sizeof(*drd), GFP_KERNEL);
+	if (!drd)
+		return -ENOMEM;
+
+	drd->dev = dev;
+	platform_set_drvdata(pdev, drd);
+
+	drd->reg_phy = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(drd->reg_phy))
+		return PTR_ERR(drd->reg_phy);
+
+	drd->reg_phy2 = devm_platform_ioremap_resource(pdev, 1);
+	if (IS_ERR(drd->reg_phy2))
+		return dev_err_probe(dev, PTR_ERR(drd->reg_phy2),
+				     "second PHY window is required\n");
+
+	drd->reg_refclk = devm_platform_ioremap_resource(pdev, 2);
+	if (IS_ERR(drd->reg_refclk))
+		return dev_err_probe(dev, PTR_ERR(drd->reg_refclk),
+				     "refclk selector window is required\n");
+
+	drd->bus_clk = devm_clk_get(dev, "phy");
+	if (IS_ERR(drd->bus_clk))
+		return dev_err_probe(dev, PTR_ERR(drd->bus_clk),
+				     "no bus clock\n");
+
+	drd->ref_clk = devm_clk_get(dev, "ref");
+	if (IS_ERR(drd->ref_clk))
+		return dev_err_probe(dev, PTR_ERR(drd->ref_clk),
+				     "no reference clock\n");
+
+	drd->pmu = syscon_regmap_lookup_by_phandle(dev->of_node,
+						   "samsung,pmu-syscon");
+	if (IS_ERR(drd->pmu))
+		return dev_err_probe(dev, PTR_ERR(drd->pmu),
+				     "failed to look up PMU regmap\n");
+
+	/* Point the PHY multiplier at the on-chip reference. */
+	reg = readl(drd->reg_refclk + EXYNOS8895_REFCLK_SEL_OFFSET);
+	reg |= EXYNOS8895_REFCLK_SEL_BIT;
+	writel(reg, drd->reg_refclk + EXYNOS8895_REFCLK_SEL_OFFSET);
+
+	/*
+	 * A non-zero word at offset 0 is the block version, and it means
+	 * every other register sits one word further along. Both windows
+	 * shift together.
+	 */
+	version = readl(drd->reg_phy);
+	if (version) {
+		drd->reg_phy += 4;
+		drd->reg_phy2 += 4;
+		dev_info(dev, "USBCON version %#x, registers shifted by 4\n",
+			 version);
+	}
+
+	drd->phy = devm_phy_create(dev, NULL, &exynos8895_usbdrd_ops);
+	if (IS_ERR(drd->phy))
+		return dev_err_probe(dev, PTR_ERR(drd->phy),
+				     "failed to create PHY\n");
+	phy_set_drvdata(drd->phy, drd);
+
+	provider = devm_of_phy_provider_register(dev, exynos8895_usbdrd_xlate);
+
+	return PTR_ERR_OR_ZERO(provider);
+}
+
+static const struct of_device_id exynos8895_usbdrd_of_match[] = {
+	{ .compatible = "samsung,exynos8895-usbdrd-phy" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, exynos8895_usbdrd_of_match);
+
+static struct platform_driver exynos8895_usbdrd_driver = {
+	.probe	= exynos8895_usbdrd_probe,
+	.driver	= {
+		.name		= "exynos8895-usbdrd-phy",
+		.of_match_table	= exynos8895_usbdrd_of_match,
+	},
+};
+module_platform_driver(exynos8895_usbdrd_driver);
+
+MODULE_DESCRIPTION("Samsung Exynos8895 USB DRD PHY driver");
+MODULE_LICENSE("GPL");
