+static ssize_t dsim_selftest_store(struct device *dev,
+				  struct device_attribute *attr,
+				  const char *buf, size_t count)
+{
+	struct samsung_dsim *dsi = dev_get_drvdata(dev);
+	int ret;
+
+	if (!sysfs_streq(buf, "power") && !sysfs_streq(buf, "status"))
+		return -EINVAL;
+
+	ret = pm_runtime_resume_and_get(dev);
+	if (ret < 0)
+		return ret;
+
+	if (sysfs_streq(buf, "power")) {
+		dev_info(dev, "DSIM self-test: clocks, PHY and power domain are on\n");
