+		 * subnode, and the write site in downstream ufs-exynos.c
+		 * exynos_ufs_ctrl_phy_pwr()) — the exynos7-ufs-phy driver's
+		 * own default (0x720) is Exynos7420's register, not ours.
+		 * Previous boot attempt with the 0x720 default hung solid;
+		 * this is the leading suspect why. See docs/progress-log.md.
+		 */
+		ufs_phy: phy@11124000 {
+			compatible = "samsung,exynos8895-ufs-phy";
+			reg = <0x11124000 0x800>;
+			reg-names = "phy-pma";
+			samsung,pmu-syscon = <&pmu_system_controller 0x724>;
+			#phy-cells = <0>;
+			/*
+			 * Один такт, а не четыре. Четырёхтактовая модель
+			 * (tx0/rx0/rx1_symbol_clk) — это Exynos7420; у 8895
+			 * таких гейтов нет вообще, PHY тактируется от
+			 * опорного через мультиплексор внутри HCI. Раньше
+			 * здесь стояли три фиктивных &oscclk только ради
