+	/* Hold the D-PHY in reset while resetting and programming the link. */
+	reg = samsung_dsim_read(dsi, DSIM_SWRST_REG);
+	reg &= ~EXYNOS8895_DSIM_DPHY_RESETN;
+	samsung_dsim_write(dsi, DSIM_SWRST_REG, reg);
+	samsung_dsim_write(dsi, DSIM_SWRST_REG, reg | DSIM_SWRST);
+	ret = readl_poll_timeout(dsi->reg_base +
+				 dsi->driver_data->reg_ofs[DSIM_SWRST_REG], reg,
+				 !(reg & DSIM_SWRST), 10, 10000);
