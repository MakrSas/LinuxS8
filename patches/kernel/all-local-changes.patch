+		 * reading sysreg_fsys0 (0x11020700) from userspace after boot
+		 * gives a bus error, while CMU_FSYS0 itself still reads fine.
+		 * Drop these once the UFS/USB blocks properly claim their
+		 * clocks and power domains.
+		 */
+		bootargs = "clk_ignore_unused pd_ignore_unused console=ttySAC0,115200 console=tty0";
+
 		framebuffer: framebuffer@cc000000 {
 			compatible = "simple-framebuffer";
 			reg = <0 0xcc000000 (1440 * 2960 * 4)>;
@@ -48,11 +60,20 @@ reserved-memory {
 		#size-cells = <1>;
 		ranges;
 
+		/*
+		 * Enlarged from the upstream 0x8000 and given a pmsg area: the
+		 * framebuffer console is our only output, so when a driver
+		 * wedges the display we go blind even if the kernel is still
+		 * running. ramoops survives a warm reset, so the next boot can
+		 * read back both the kernel log and userspace markers written
+		 * to /dev/pmsg0 from the boot that appeared to hang.
+		 */
