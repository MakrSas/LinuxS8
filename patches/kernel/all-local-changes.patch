+	udelay(400);
+	reg = samsung_dsim_read(dsi, DSIM_CLKCTRL_REG);
+	reg |= EXYNOS8895_DSIM_LANE_ESC_MASK |
+	       EXYNOS8895_DSIM_WORDCLK_EN |
+	       EXYNOS8895_DSIM_NONCONT_CLK;
+	samsung_dsim_write(dsi, DSIM_CLKCTRL_REG, reg);
+	reg = samsung_dsim_read(dsi, DSIM_SWRST_REG);
+	reg |= EXYNOS8895_DSIM_DPHY_RESETN;
+	samsung_dsim_write(dsi, DSIM_SWRST_REG, reg);
+
+	/* 1440x2960 command mode, 3:1 DSC, two 720-pixel slices. */
+	samsung_dsim_write(dsi, DSIM_TIMEOUT_REG, 0x00ffffff);
+	samsung_dsim_write(dsi, DSIM_ESCMODE_REG, 0x01400000);
+	writel(2960, dsi->reg_base + EXYNOS8895_DSIM_NUM_TRANSFER);
+	writel(3022, dsi->reg_base + EXYNOS8895_DSIM_UNDERRUN_CTRL);
+	writel(480, dsi->reg_base + EXYNOS8895_DSIM_THRESHOLD);
+	samsung_dsim_write(dsi, DSIM_MDRESOL_REG, (2960 << 16) | 480);
+	samsung_dsim_write(dsi, DSIM_CONFIG_REG,
+			   EXYNOS8895_DSIM_CPRS_EN |
+			   EXYNOS8895_DSIM_EOTP_EN |
+			   (3 << 5) | EXYNOS8895_DSIM_LANES);
+	writel(BIT(3) | 2, dsi->reg_base + EXYNOS8895_DSIM_CPRS_CTRL);
+	writel((720 << 16) | 720, dsi->reg_base + EXYNOS8895_DSIM_SLICE01);
+	writel((720 << 16) | 720, dsi->reg_base + EXYNOS8895_DSIM_SLICE23);
+	writel(86, dsi->reg_base + EXYNOS8895_DSIM_CMD_TE_CTRL0);
+	writel((8867 << 16) | 10102,
