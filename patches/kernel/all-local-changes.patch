+		udelay(10);
+		writel(reg & ~LINKSYSTEM_LINK_SW_RESET,
+		       phy_drd->reg_phy + EXYNOS5_DRD_LINKSYSTEM);
+	}
+
 	/*
 	 * Setting the Frame length Adj value[6:1] to default 0x20
 	 * See xHCI 1.0 spec, 5.2.4
@@ -2969,6 +3027,46 @@ static int exynos5_usbdrd_phy_probe(struct platform_device *pdev)
 			return PTR_ERR(phy_drd->reg_phy);
 	}
 
+	/*
+	 * Newer revisions of this block put a version register at offset 0
