+		 * Rate-limited because the block layer retries every failing
+		 * sector and the console is being read off a photograph.
+		 */
+		if (host->dbg_data_err++ < 3) {
+			dev_err(host->dev, "  tcb %u tbb %u sts %08x cmd %08x blk %u/%u\n",
