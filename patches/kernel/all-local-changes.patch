diff --git a/drivers/gpu/drm/exynos/exynos8895_drm_decon.c b/drivers/gpu/drm/exynos/exynos8895_drm_decon.c
new file mode 100644
index 000000000..46e05bf5b
--- /dev/null
+++ b/drivers/gpu/drm/exynos/exynos8895_drm_decon.c
@@ -0,0 +1,888 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Minimal DRM/KMS scanout driver for Exynos8895 DECON0.
+ *
+ * Galaxy S8 (dreamlte) uses this fixed command-mode path:
+ *   IDMA_G1 -> DPP_G1 -> DECON0 -> DSC0/1 -> DSIM0 -> S6E3HA6
+ */
+
+#include <linux/clk.h>
+#include <linux/component.h>
+#include <linux/dma-mapping.h>
+#include <linux/iopoll.h>
+#include <linux/mfd/syscon.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
+#include <linux/regmap.h>
+
+#include <drm/drm_fourcc.h>
+#include <drm/drm_framebuffer.h>
+#include <drm/drm_print.h>
+#include <drm/drm_vblank.h>
+#include <drm/exynos_drm.h>
+
+#include "exynos_drm_crtc.h"
+#include "exynos_drm_drv.h"
+#include "exynos_drm_fb.h"
+#include "exynos_drm_plane.h"
+
+#define EXYNOS8895_WIDTH			1440
+#define EXYNOS8895_HEIGHT			2960
+#define EXYNOS8895_DSC_WIDTH			240
+#define EXYNOS8895_DSI_WIDTH			480
+
+/* DPU0 display sysreg. */
+#define SYSREG_DISP_LPMUX_CFG			0x0000
+#define SYSREG_DISP_DLMUX_CFG			0x0004
+#define SYSREG_DISP_TE_SEL			0x000c
+#define SYSREG_DLMUX_MASK			0x00033077
+#define SYSREG_DLMUX_DECON0_DSIM0		0x00010041
+
+/* DECON0. */
+#define DECON_GLOBAL_CONTROL			0x0000
+#define DECON_GLOBAL_SRESET			BIT(28)
+#define DECON_GLOBAL_I80IF			BIT(8)
+#define DECON_GLOBAL_RUN_STATUS			BIT(4)
+#define DECON_GLOBAL_ENABLE			BIT(1)
+#define DECON_GLOBAL_ENABLE_F			BIT(0)
+#define DECON_SRAM_SHARE_ENABLE			0x0030
+#define DECON_SRAM_FIFO_8K			(BIT(24) | BIT(12))
+#define DECON_INTERRUPT_ENABLE			0x0040
+#define DECON_FRAME_DONE_INT_EN			BIT(13)
+#define DECON_INT_EN				BIT(0)
+#define DECON_INTERRUPT_ENABLE_MASK		0x03303711
+#define DECON_EXTRA_INTERRUPT_ENABLE		0x0044
+#define DECON_EXTRA_INTERRUPT_MASK		0x00000111
+#define DECON_INTERRUPT_PENDING			0x004c
+#define DECON_FRAME_DONE_INT_PEND		BIT(13)
+#define DECON_INTERRUPT_PENDING_ALL		0x03303110
+#define DECON_EXTRA_INTERRUPT_PENDING		0x0050
+#define DECON_SHADOW_UPDATE			0x0060
+#define DECON_SHADOW_UPDATE_GLOBAL		BIT(31)
+#define DECON_SHADOW_UPDATE_WIN(win)		BIT(win)
+#define DECON_TRIGGER_CONTROL			0x0070
+#define DECON_TRIGGER_MASK			BIT(4)
+#define DECON_TRIGGER_ENABLE			BIT(0)
+#define DECON_CLOCK_CONTROL			0x00f0
+#define DECON_CLOCK_CONTROL_MASK		0x00511101
+
+#define DECON_SPLITTER_SIZE			0x0100
+#define DECON_SPLITTER_PIXEL_COUNT		0x0104
+#define DECON_SPLITTER_INDEX			0x0108
+#define DECON_SPLITTER_OVERLAP			0x010c
+#define DECON_FIFO0_SIZE			0x0120
+#define DECON_FIFO0_PIXEL_COUNT			0x0124
+#define DECON_FIFO1_SIZE			0x0128
+#define DECON_FIFO1_PIXEL_COUNT			0x012c
+#define DECON_FIFO_THRESHOLD			0x0130
+#define DECON_FORMATTER_CONTROL			0x0190
+#define DECON_FORMATTER_RGB_ORDER_MASK		GENMASK(6, 4)
+#define DECON_FORMATTER0_SIZE			0x01a0
+#define DECON_FORMATTER0_PIXEL_COUNT		0x01a4
+#define DECON_BG_SIZE				0x0200
+#define DECON_BG_PIXEL_COUNT			0x0204
+#define DECON_DATA_PATH_CONTROL0		0x0214
+#define DECON_WIN_ENABLE(win)			BIT(4 * (win))
+#define DECON_DATA_PATH_CONTROL1		0x0218
+#define DECON_WIN_CHMAP(win, channel)		(((channel) & 0x7) << (4 * (win)))
+#define DECON_WIN_CHMAP_MASK(win)		(0x7 << (4 * (win)))
+#define DECON_DATA_PATH_CONTROL2		0x0230
+#define DECON_DATA_PATH_DUAL_DSC_DSIM0		0x000000b1
+
+#define DECON_WIN_CONTROL0(win)		(0x1000 + (win) * 0x30)
+#define DECON_WIN_CONTROL1(win)		(0x1004 + (win) * 0x30)
+#define DECON_WIN_START(win)			(0x1008 + (win) * 0x30)
+#define DECON_WIN_END(win)			(0x100c + (win) * 0x30)
+#define DECON_WIN_START_TIME(win)		(0x1018 + (win) * 0x30)
+#define DECON_WIN_PIXEL_COUNT(win)		(0x101c + (win) * 0x30)
+#define DECON_WIN_ALPHA0(value)		((u32)(value) << 16)
+#define DECON_WIN_ALPHA1(value)		((u32)(value) << 24)
+#define DECON_WIN_FUNC_COPY			(1 << 8)
+#define DECON_IDMA_G1_CHANNEL			3
+
+/* The two DSC encoders have identical register files. */
+#define DECON_DSC0				0x4000
+#define DECON_DSC1				0x5000
+#define DSC_CONTROL0				0x0000
+#define DSC_PPS04_07				0x0024
+#define DSC_PPS08_11				0x0028
+#define DSC_PPS12_15				0x002c
+#define DSC_PPS16_19				0x0030
+#define DSC_PPS20_23				0x0034
+#define DSC_PPS24_27				0x0038
+#define DSC_PPS28_31				0x003c
+#define DSC_PPS32_35				0x0040
+#define DSC_PPS56_59				0x0058
+#define DSC_PPS76_79				0x006c
+#define DSC_PPS80_83				0x0070
+#define DSC_PPS84_87				0x0074
+#define DSC_CONTROL0_DREAMLTE			0x000f022a
+
+/* DPU DMA common block. */
+#define DMA_COMMON_CH_MAP			0x0004
+#define DMA_COMMON_G1_CH_MASK			GENMASK(5, 4)
+#define DMA_COMMON_G1_TO_CH2			(2 << 4)
+#define DMA_COMMON_CLOCK_GATING			0x0014
+#define DMA_COMMON_CLOCK_GATING_MASK		0x00010fff
+
+/* IDMA_G1. */
+#define IDMA_ENABLE				0x0000
+#define IDMA_CLOCK_GATING_MASK			GENMASK(10, 9)
+#define IDMA_IRQ				0x0004
+#define IDMA_IRQ_MASK_ALL			(0xfb << 1)
+#define IDMA_IN_CON				0x0008
+#define IDMA_IN_IC_MAX				(0x10 << 19)
+#define IDMA_FORMAT(value)			((value) << 11)
+#define IDMA_OUT_CON				0x000c
+#define IDMA_FRAME_ALPHA(value)		((u32)(value) << 24)
+#define IDMA_SRC_SIZE				0x0010
+#define IDMA_SRC_OFFSET				0x0014
+#define IDMA_IMG_SIZE				0x0018
+#define IDMA_QOS_LUT0				0x0034
+#define IDMA_QOS_LUT1				0x0038
+#define IDMA_BASE_ADDR_Y			0x0040
+#define IDMA_DYNAMIC_GATING			0x0058
+#define IDMA_DYNAMIC_GATING_ALL			0x0000007f
+#define IDMA_RECOVERY_CONTROL			0x005c
+#define IDMA_INITIAL_RECOVERY_NUM		(630000 << 1)
+
+/* DPP_G1. */
+#define DPP_ENABLE				0x0000
+#define DPP_CLOCK_GATING_MASK			GENMASK(10, 8)
+#define DPP_IRQ				0x0004
+#define DPP_IRQ_MASK_ALL			(0x21 << 1)
+#define DPP_IN_CON				0x0008
+#define DPP_ALPHA_PER_PIXEL			BIT(10)
+#define DPP_IMG_SIZE				0x0018
+#define DPP_DYNAMIC_GATING			0x0a54
+#define DPP_DYNAMIC_GATING_ALL			0x0000005f
+
+#define HW_SIZE(width, height)			(((height) << 16) | (width))
+#define HW_POSITION(x, y)			(((y) << 16) | (x))
+
+enum exynos8895_decon_clk {
+	DECON_ACLK,
+	DECON_PCLKM,
+	DECON_PCLKS,
+	DPP_ACLK,
+	DPP_PCLKM,
+	DPP_PCLKS,
+	DECON_NUM_CLKS,
+};
+
+struct exynos8895_decon {
+	struct device *dev;
+	struct drm_device *drm_dev;
+	void *dma_priv;
+	void __iomem *regs;
+	void __iomem *dpp;
+	void __iomem *idma;
+	void __iomem *dma_common;
+	struct regmap *sysreg;
+	struct clk_bulk_data clks[DECON_NUM_CLKS];
+	struct exynos_drm_crtc *crtc;
+	struct exynos_drm_plane plane;
+	struct exynos_drm_plane_config plane_config;
+	int irq;
+	bool irq_enabled;
+	bool active;
+};
+
+static const uint32_t exynos8895_formats[] = {
+	DRM_FORMAT_RGB565,
+	DRM_FORMAT_XRGB8888,
+	DRM_FORMAT_XBGR8888,
+	DRM_FORMAT_RGBX8888,
+	DRM_FORMAT_BGRX8888,
+	DRM_FORMAT_ARGB8888,
+	DRM_FORMAT_ABGR8888,
+	DRM_FORMAT_RGBA8888,
+	DRM_FORMAT_BGRA8888,
+};
+
+static inline u32 decon_read(struct exynos8895_decon *ctx, u32 reg)
+{
+	return readl(ctx->regs + reg);
+}
+
+static inline void decon_write(struct exynos8895_decon *ctx, u32 reg, u32 val)
+{
+	writel(val, ctx->regs + reg);
+}
+
+static void decon_update_bits(struct exynos8895_decon *ctx, u32 reg,
+			      u32 mask, u32 val)
+{
+	u32 tmp = decon_read(ctx, reg);
+
+	decon_write(ctx, reg, (tmp & ~mask) | (val & mask));
+}
+
+static inline u32 idma_read(struct exynos8895_decon *ctx, u32 reg)
+{
+	return readl(ctx->idma + reg);
+}
+
+static inline void idma_write(struct exynos8895_decon *ctx, u32 reg, u32 val)
+{
+	writel(val, ctx->idma + reg);
+}
+
+static void idma_update_bits(struct exynos8895_decon *ctx, u32 reg,
+			     u32 mask, u32 val)
+{
+	u32 tmp = idma_read(ctx, reg);
+
+	idma_write(ctx, reg, (tmp & ~mask) | (val & mask));
+}
+
+static inline u32 dpp_read(struct exynos8895_decon *ctx, u32 reg)
+{
+	return readl(ctx->dpp + reg);
+}
+
+static inline void dpp_write(struct exynos8895_decon *ctx, u32 reg, u32 val)
+{
+	writel(val, ctx->dpp + reg);
+}
+
+static void dpp_update_bits(struct exynos8895_decon *ctx, u32 reg,
+			    u32 mask, u32 val)
+{
+	u32 tmp = dpp_read(ctx, reg);
+
+	dpp_write(ctx, reg, (tmp & ~mask) | (val & mask));
+}
+
+static inline u32 dma_common_read(struct exynos8895_decon *ctx, u32 reg)
+{
+	return readl(ctx->dma_common + reg);
+}
+
+static void dma_common_update_bits(struct exynos8895_decon *ctx, u32 reg,
+				   u32 mask, u32 val)
+{
+	u32 tmp = dma_common_read(ctx, reg);
+
+	writel((tmp & ~mask) | (val & mask), ctx->dma_common + reg);
+}
+
+static void decon_shadow_update(struct exynos8895_decon *ctx)
+{
+	/* Window registers have their own shadow-request bits on Exynos8895. */
+	decon_write(ctx, DECON_SHADOW_UPDATE,
+		    DECON_SHADOW_UPDATE_GLOBAL | DECON_SHADOW_UPDATE_WIN(0));
+}
+
+static void decon_trigger(struct exynos8895_decon *ctx, bool enable)
+{
+	u32 val = enable ? DECON_TRIGGER_ENABLE : DECON_TRIGGER_MASK;
+
+	decon_update_bits(ctx, DECON_TRIGGER_CONTROL,
+			  DECON_TRIGGER_ENABLE | DECON_TRIGGER_MASK, val);
+}
+
+static u32 idma_format(u32 format)
+{
+	switch (format) {
+	case DRM_FORMAT_ARGB8888:
+		return IDMA_FORMAT(0);
+	case DRM_FORMAT_ABGR8888:
+		return IDMA_FORMAT(1);
+	case DRM_FORMAT_RGBA8888:
+		return IDMA_FORMAT(2);
+	case DRM_FORMAT_BGRA8888:
+		return IDMA_FORMAT(3);
+	case DRM_FORMAT_XRGB8888:
+		return IDMA_FORMAT(4);
+	case DRM_FORMAT_XBGR8888:
+		return IDMA_FORMAT(5);
+	case DRM_FORMAT_RGBX8888:
+		return IDMA_FORMAT(6);
+	case DRM_FORMAT_BGRX8888:
+		return IDMA_FORMAT(7);
+	case DRM_FORMAT_RGB565:
+		return IDMA_FORMAT(8);
+	default:
+		return IDMA_FORMAT(4);
+	}
+}
+
+static bool format_has_alpha(u32 format)
+{
+	return format == DRM_FORMAT_ARGB8888 ||
+	       format == DRM_FORMAT_ABGR8888 ||
+	       format == DRM_FORMAT_RGBA8888 ||
+	       format == DRM_FORMAT_BGRA8888;
+}
+
+static void decon_dsc_program(struct exynos8895_decon *ctx, u32 base)
+{
+	u32 val;
+
+	/* Two encoders, one 720x40 slice per encoder, 8 bpc and 8 bpp. */
+	decon_write(ctx, base + DSC_CONTROL0, DSC_CONTROL0_DREAMLTE);
+	decon_write(ctx, base + DSC_PPS04_07, 0x30800b90);
+	decon_write(ctx, base + DSC_PPS08_11, 0x02d00028);
+	decon_write(ctx, base + DSC_PPS12_15, 0x02d002d0);
+	decon_write(ctx, base + DSC_PPS16_19, 0x020001b4);
+	decon_write(ctx, base + DSC_PPS20_23, 0x0020046c);
+	decon_write(ctx, base + DSC_PPS24_27, 0x000a000c);
+	decon_write(ctx, base + DSC_PPS28_31, 0x027701e9);
+	decon_write(ctx, base + DSC_PPS32_35, 0x180010f0);
+	val = decon_read(ctx, base + DSC_PPS56_59);
+	decon_write(ctx, base + DSC_PPS56_59, (val & 0xffff0000) | 0x0102);
+	decon_write(ctx, base + DSC_PPS76_79, 0x1ab62af6);
+	decon_write(ctx, base + DSC_PPS80_83, 0x2b342b74);
+	decon_write(ctx, base + DSC_PPS84_87, 0x3b746bf4);
+}
+
+static int decon_route_display(struct exynos8895_decon *ctx)
+{
+	int ret;
+
+	ret = regmap_write(ctx->sysreg, SYSREG_DISP_LPMUX_CFG, 0x1201);
+	if (ret)
+		return ret;
+	ret = regmap_update_bits(ctx->sysreg, SYSREG_DISP_DLMUX_CFG,
+				 SYSREG_DLMUX_MASK, SYSREG_DLMUX_DECON0_DSIM0);
+	if (ret)
+		return ret;
+
+	return regmap_write(ctx->sysreg, SYSREG_DISP_TE_SEL, 0x7);
+}
+
+static void dpp_hw_init(struct exynos8895_decon *ctx)
+{
+	dma_common_update_bits(ctx, DMA_COMMON_CH_MAP,
+			       DMA_COMMON_G1_CH_MASK, DMA_COMMON_G1_TO_CH2);
+	dma_common_update_bits(ctx, DMA_COMMON_CLOCK_GATING,
+			       DMA_COMMON_CLOCK_GATING_MASK,
+			       DMA_COMMON_CLOCK_GATING_MASK);
+
+	idma_write(ctx, IDMA_IRQ, IDMA_IRQ_MASK_ALL);
+	dpp_write(ctx, DPP_IRQ, DPP_IRQ_MASK_ALL);
+	idma_update_bits(ctx, IDMA_ENABLE, IDMA_CLOCK_GATING_MASK,
+			 IDMA_CLOCK_GATING_MASK);
+	dpp_update_bits(ctx, DPP_ENABLE, DPP_CLOCK_GATING_MASK,
+			DPP_CLOCK_GATING_MASK);
+	idma_write(ctx, IDMA_QOS_LUT0, 0x44444444);
+	idma_write(ctx, IDMA_QOS_LUT1, 0x44444444);
+	idma_write(ctx, IDMA_DYNAMIC_GATING, IDMA_DYNAMIC_GATING_ALL);
+	dpp_write(ctx, DPP_DYNAMIC_GATING, DPP_DYNAMIC_GATING_ALL);
+	idma_write(ctx, IDMA_OUT_CON, IDMA_FRAME_ALPHA(0xff));
+	idma_write(ctx, IDMA_RECOVERY_CONTROL, IDMA_INITIAL_RECOVERY_NUM);
+}
+
+static int decon_hw_init(struct exynos8895_decon *ctx)
+{
+	u32 count = EXYNOS8895_DSC_WIDTH * EXYNOS8895_HEIGHT;
+	int ret;
+
+	/* Freeze a bootloader-owned command-mode scanout before shadow writes. */
+	if (decon_read(ctx, DECON_GLOBAL_CONTROL) & DECON_GLOBAL_RUN_STATUS)
+		dev_info(ctx->dev, "taking over running bootloader DECON\n");
+	decon_trigger(ctx, false);
+	decon_update_bits(ctx, DECON_INTERRUPT_ENABLE,
+			  DECON_INTERRUPT_ENABLE_MASK, 0);
+	decon_update_bits(ctx, DECON_EXTRA_INTERRUPT_ENABLE,
+			  DECON_EXTRA_INTERRUPT_MASK, 0);
+	decon_write(ctx, DECON_INTERRUPT_PENDING,
+		    DECON_INTERRUPT_PENDING_ALL);
+	decon_write(ctx, DECON_EXTRA_INTERRUPT_PENDING,
+		    DECON_EXTRA_INTERRUPT_MASK);
+
+	ret = decon_route_display(ctx);
+	if (ret)
+		return ret;
+
+	decon_update_bits(ctx, DECON_CLOCK_CONTROL, DECON_CLOCK_CONTROL_MASK,
+			  DECON_CLOCK_CONTROL_MASK);
+	decon_write(ctx, DECON_SRAM_SHARE_ENABLE, DECON_SRAM_FIFO_8K);
+	decon_update_bits(ctx, DECON_GLOBAL_CONTROL, DECON_GLOBAL_I80IF,
+			  DECON_GLOBAL_I80IF);
+	decon_write(ctx, DECON_BG_SIZE,
+		    HW_SIZE(EXYNOS8895_WIDTH, EXYNOS8895_HEIGHT));
+	decon_write(ctx, DECON_BG_PIXEL_COUNT,
+		    EXYNOS8895_WIDTH * EXYNOS8895_HEIGHT);
+
+	decon_dsc_program(ctx, DECON_DSC0);
+	decon_dsc_program(ctx, DECON_DSC1);
+	decon_write(ctx, DECON_DATA_PATH_CONTROL2,
+		    DECON_DATA_PATH_DUAL_DSC_DSIM0);
+	decon_write(ctx, DECON_SPLITTER_SIZE,
+		    HW_SIZE(EXYNOS8895_DSI_WIDTH, EXYNOS8895_HEIGHT));
+	decon_write(ctx, DECON_SPLITTER_PIXEL_COUNT, count);
+	decon_write(ctx, DECON_SPLITTER_INDEX, EXYNOS8895_DSC_WIDTH);
+	decon_write(ctx, DECON_SPLITTER_OVERLAP, 0);
+	decon_write(ctx, DECON_FIFO0_SIZE,
+		    HW_SIZE(EXYNOS8895_DSC_WIDTH, EXYNOS8895_HEIGHT));
+	decon_write(ctx, DECON_FIFO0_PIXEL_COUNT, count);
+	decon_write(ctx, DECON_FIFO1_SIZE,
+		    HW_SIZE(EXYNOS8895_DSC_WIDTH, EXYNOS8895_HEIGHT));
+	decon_write(ctx, DECON_FIFO1_PIXEL_COUNT, count);
+	decon_write(ctx, DECON_FIFO_THRESHOLD,
+		    (EXYNOS8895_DSC_WIDTH << 16) | EXYNOS8895_DSC_WIDTH);
+	decon_update_bits(ctx, DECON_FORMATTER_CONTROL,
+			  DECON_FORMATTER_RGB_ORDER_MASK, 0);
+	decon_write(ctx, DECON_FORMATTER0_SIZE,
+		    HW_SIZE(EXYNOS8895_DSI_WIDTH, EXYNOS8895_HEIGHT));
+	decon_write(ctx, DECON_FORMATTER0_PIXEL_COUNT,
+		    EXYNOS8895_DSI_WIDTH * EXYNOS8895_HEIGHT);
+
+	decon_update_bits(ctx, DECON_DATA_PATH_CONTROL1,
+			  DECON_WIN_CHMAP_MASK(0),
+			  DECON_WIN_CHMAP(0, DECON_IDMA_G1_CHANNEL));
+	decon_update_bits(ctx, DECON_DATA_PATH_CONTROL0,
+			  DECON_WIN_ENABLE(0), 0);
+	dpp_hw_init(ctx);
+
+	decon_write(ctx, DECON_INTERRUPT_PENDING,
+		    DECON_INTERRUPT_PENDING_ALL);
+	decon_write(ctx, DECON_EXTRA_INTERRUPT_PENDING,
+		    DECON_EXTRA_INTERRUPT_MASK);
+	if (!ctx->irq_enabled) {
+		enable_irq(ctx->irq);
+		ctx->irq_enabled = true;
+	}
+	decon_update_bits(ctx, DECON_INTERRUPT_ENABLE,
+			  DECON_FRAME_DONE_INT_EN | DECON_INT_EN,
+			  DECON_FRAME_DONE_INT_EN | DECON_INT_EN);
+	return 0;
+}
+
+static int decon_start(struct exynos8895_decon *ctx)
+{
+	u32 val;
+	int ret;
+
+	decon_update_bits(ctx, DECON_GLOBAL_CONTROL,
+			  DECON_GLOBAL_ENABLE | DECON_GLOBAL_ENABLE_F,
+			  DECON_GLOBAL_ENABLE | DECON_GLOBAL_ENABLE_F);
+	decon_shadow_update(ctx);
+	ret = readl_poll_timeout(ctx->regs + DECON_GLOBAL_CONTROL, val,
+				 val & DECON_GLOBAL_RUN_STATUS, 10, 20000);
+	if (ret)
+		return dev_err_probe(ctx->dev, ret,
+				     "DECON did not enter run state\n");
+
+	decon_trigger(ctx, true);
+	return 0;
+}
+
+static void decon_stop(struct exynos8895_decon *ctx)
+{
+	u32 val;
+
+	decon_trigger(ctx, false);
+	decon_update_bits(ctx, DECON_INTERRUPT_ENABLE,
+			  DECON_INTERRUPT_ENABLE_MASK, 0);
+	decon_update_bits(ctx, DECON_EXTRA_INTERRUPT_ENABLE,
+			  DECON_EXTRA_INTERRUPT_MASK, 0);
+	decon_write(ctx, DECON_INTERRUPT_PENDING,
+		    DECON_INTERRUPT_PENDING_ALL);
+	decon_write(ctx, DECON_EXTRA_INTERRUPT_PENDING,
+		    DECON_EXTRA_INTERRUPT_MASK);
+	if (ctx->irq_enabled) {
+		disable_irq(ctx->irq);
+		ctx->irq_enabled = false;
+	}
+	decon_update_bits(ctx, DECON_DATA_PATH_CONTROL0,
+			  DECON_WIN_ENABLE(0), 0);
+	decon_update_bits(ctx, DECON_GLOBAL_CONTROL,
+			  DECON_GLOBAL_ENABLE_F, 0);
+	decon_shadow_update(ctx);
+	if (readl_poll_timeout(ctx->regs + DECON_GLOBAL_CONTROL, val,
+			       !(val & DECON_GLOBAL_RUN_STATUS), 10, 20000))
+		dev_warn(ctx->dev, "DECON did not leave run state\n");
+}
+
+/* Diagnostic only: no reset or routing write is exposed through sysfs. */
+static ssize_t decon_selftest_store(struct device *dev,
+				   struct device_attribute *attr,
+				   const char *buf, size_t count)
+{
+	struct exynos8895_decon *ctx = dev_get_drvdata(dev);
+	u32 dlmux, lpmux, te;
+	int ret;
+
+	ret = pm_runtime_resume_and_get(dev);
+	if (ret < 0)
+		return ret;
+
+	if (sysfs_streq(buf, "power")) {
+		dev_info(dev, "DECON self-test: clocks and power domain are on\n");
+	} else if (sysfs_streq(buf, "status")) {
+		regmap_read(ctx->sysreg, SYSREG_DISP_LPMUX_CFG, &lpmux);
+		regmap_read(ctx->sysreg, SYSREG_DISP_DLMUX_CFG, &dlmux);
+		regmap_read(ctx->sysreg, SYSREG_DISP_TE_SEL, &te);
+		dev_info(dev,
+			 "DECON status: global=%08x int=%08x/%08x trig=%08x path=%08x win=%08x\n",
+			 decon_read(ctx, DECON_GLOBAL_CONTROL),
+			 decon_read(ctx, DECON_INTERRUPT_ENABLE),
+			 decon_read(ctx, DECON_INTERRUPT_PENDING),
+			 decon_read(ctx, DECON_TRIGGER_CONTROL),
+			 decon_read(ctx, DECON_DATA_PATH_CONTROL2),
+			 decon_read(ctx, DECON_DATA_PATH_CONTROL0));
+		dev_info(dev,
+			 "DPU route: lpmux=%08x dlmux=%08x te=%08x; IDMA=%08x DPP=%08x\n",
+			 lpmux, dlmux, te, idma_read(ctx, IDMA_ENABLE),
+			 dpp_read(ctx, DPP_ENABLE));
+		dev_info(dev,
+			 "scanout: shadow=%08x addr=%08x src=%08x img=%08x dpp-in=%08x dpp-img=%08x dsc=%08x/%08x\n",
+			 decon_read(ctx, DECON_SHADOW_UPDATE),
+			 idma_read(ctx, IDMA_BASE_ADDR_Y),
+			 idma_read(ctx, IDMA_SRC_SIZE),
+			 idma_read(ctx, IDMA_IMG_SIZE),
+			 dpp_read(ctx, DPP_IN_CON),
+			 dpp_read(ctx, DPP_IMG_SIZE),
+			 decon_read(ctx, DECON_DSC0 + DSC_CONTROL0),
+			 decon_read(ctx, DECON_DSC1 + DSC_CONTROL0));
+		dev_info(dev, "DMA IRQ: idma=%08x dpp=%08x\n",
+			 idma_read(ctx, IDMA_IRQ), dpp_read(ctx, DPP_IRQ));
+	} else {
+		ret = -EINVAL;
+	}
+
+	pm_runtime_put_sync(dev);
+	return ret < 0 ? ret : count;
+}
+static DEVICE_ATTR_WO(decon_selftest);
+
+static void decon_update_plane(struct exynos_drm_crtc *crtc,
+			       struct exynos_drm_plane *plane)
+{
+	struct exynos8895_decon *ctx = crtc->ctx;
+	struct exynos_drm_plane_state *state =
+		to_exynos_plane_state(plane->base.state);
+	struct drm_framebuffer *fb = state->base.fb;
+	u32 alpha, cpp, full_width, win;
+	dma_addr_t addr;
+
+	if (!ctx->active || !fb)
+		return;
+
+	cpp = fb->format->cpp[0];
+	full_width = fb->pitches[0] / cpp;
+	addr = exynos_drm_fb_dma_addr(fb, 0);
+
+	idma_write(ctx, IDMA_IN_CON,
+		   IDMA_IN_IC_MAX | idma_format(fb->format->format));
+	idma_write(ctx, IDMA_OUT_CON, IDMA_FRAME_ALPHA(0xff));
+	idma_write(ctx, IDMA_SRC_OFFSET,
+		   HW_POSITION(state->src.x, state->src.y));
+	idma_write(ctx, IDMA_SRC_SIZE, HW_SIZE(full_width, fb->height));
+	idma_write(ctx, IDMA_IMG_SIZE,
+		   HW_SIZE(state->src.w, state->src.h));
+	idma_write(ctx, IDMA_BASE_ADDR_Y, lower_32_bits(addr));
+	alpha = format_has_alpha(fb->format->format) ? DPP_ALPHA_PER_PIXEL : 0;
+	dpp_write(ctx, DPP_IN_CON, alpha);
+	dpp_write(ctx, DPP_IMG_SIZE,
+		  HW_SIZE(state->src.w, state->src.h));
+
+	win = DECON_WIN_ALPHA0(0xff) | DECON_WIN_ALPHA1(0xff) |
+	      DECON_WIN_FUNC_COPY;
+	decon_write(ctx, DECON_WIN_CONTROL0(0), win);
+	decon_write(ctx, DECON_WIN_CONTROL1(0), 0);
+	decon_write(ctx, DECON_WIN_START(0),
+		    HW_POSITION(state->crtc.x, state->crtc.y));
+	decon_write(ctx, DECON_WIN_END(0),
+		    HW_POSITION(state->crtc.x + state->crtc.w - 1,
+				state->crtc.y + state->crtc.h - 1));
+	decon_write(ctx, DECON_WIN_START_TIME(0), 0);
+	decon_write(ctx, DECON_WIN_PIXEL_COUNT(0),
+		    state->crtc.w * state->crtc.h);
+	decon_update_bits(ctx, DECON_DATA_PATH_CONTROL1,
+			  DECON_WIN_CHMAP_MASK(0),
+			  DECON_WIN_CHMAP(0, DECON_IDMA_G1_CHANNEL));
+	decon_update_bits(ctx, DECON_DATA_PATH_CONTROL0,
+			  DECON_WIN_ENABLE(0), DECON_WIN_ENABLE(0));
+
+	decon_shadow_update(ctx);
+}
+
+static void decon_disable_plane(struct exynos_drm_crtc *crtc,
+				struct exynos_drm_plane *plane)
+{
+	struct exynos8895_decon *ctx = crtc->ctx;
+
+	if (!ctx->active)
+		return;
+
+	decon_update_bits(ctx, DECON_DATA_PATH_CONTROL0,
+			  DECON_WIN_ENABLE(0), 0);
+	decon_shadow_update(ctx);
+}
+
+static void decon_atomic_enable(struct exynos_drm_crtc *crtc)
+{
+	struct exynos8895_decon *ctx = crtc->ctx;
+	int ret;
+
+	ret = pm_runtime_resume_and_get(ctx->dev);
+	if (ret < 0) {
+		dev_err(ctx->dev, "failed to power DECON: %d\n", ret);
+		return;
+	}
+
+	ctx->active = true;
+	ret = decon_hw_init(ctx);
+	if (ret)
+		goto err_put;
+	decon_update_plane(crtc, &ctx->plane);
+	ret = decon_start(ctx);
+	if (!ret)
+		return;
+
+	decon_stop(ctx);
+err_put:
+	ctx->active = false;
+	pm_runtime_put_sync(ctx->dev);
+}
+
+static void decon_atomic_disable(struct exynos_drm_crtc *crtc)
+{
+	struct exynos8895_decon *ctx = crtc->ctx;
+
+	if (!ctx->active)
+		return;
+
+	decon_stop(ctx);
+	ctx->active = false;
+	pm_runtime_put_sync(ctx->dev);
+}
+
+static int decon_enable_vblank(struct exynos_drm_crtc *crtc)
+{
+	return 0;
+}
+
+static void decon_disable_vblank(struct exynos_drm_crtc *crtc)
+{
+}
+
+static void decon_atomic_begin(struct exynos_drm_crtc *crtc)
+{
+	struct exynos8895_decon *ctx = crtc->ctx;
+
+	if (ctx->active)
+		decon_trigger(ctx, false);
+}
+
+static void decon_atomic_flush(struct exynos_drm_crtc *crtc)
+{
+	struct exynos8895_decon *ctx = crtc->ctx;
+
+	if (!ctx->active)
+		return;
+
+	decon_shadow_update(ctx);
+	decon_trigger(ctx, true);
+	exynos_crtc_handle_event(crtc);
+}
+
+static void decon_te_handler(struct exynos_drm_crtc *crtc)
+{
+	struct exynos8895_decon *ctx = crtc->ctx;
+
+	if (!ctx->active)
+		return;
+
+	drm_crtc_handle_vblank(&crtc->base);
+}
+
+static const struct exynos_drm_crtc_ops decon_crtc_ops = {
+	.atomic_enable = decon_atomic_enable,
+	.atomic_disable = decon_atomic_disable,
+	.enable_vblank = decon_enable_vblank,
+	.disable_vblank = decon_disable_vblank,
+	.atomic_begin = decon_atomic_begin,
+	.update_plane = decon_update_plane,
+	.disable_plane = decon_disable_plane,
+	.atomic_flush = decon_atomic_flush,
+	.te_handler = decon_te_handler,
+};
+
+static irqreturn_t decon_irq_handler(int irq, void *data)
+{
+	struct exynos8895_decon *ctx = data;
+	u32 pending = decon_read(ctx, DECON_INTERRUPT_PENDING) &
+		      DECON_INTERRUPT_PENDING_ALL;
+
+	if (!pending)
+		return IRQ_NONE;
+
+	decon_write(ctx, DECON_INTERRUPT_PENDING, pending);
+	return IRQ_HANDLED;
+}
+
+static int decon_bind(struct device *dev, struct device *master, void *data)
+{
+	struct exynos8895_decon *ctx = dev_get_drvdata(dev);
+	struct drm_device *drm = data;
+	int ret;
+
+	ctx->drm_dev = drm;
+	ret = exynos_drm_register_dma(drm, dev, &ctx->dma_priv);
+	if (ret)
+		return ret;
+
+	ctx->plane_config.pixel_formats = exynos8895_formats;
+	ctx->plane_config.num_pixel_formats = ARRAY_SIZE(exynos8895_formats);
+	ctx->plane_config.zpos = 0;
+	ctx->plane_config.type = DRM_PLANE_TYPE_PRIMARY;
+
+	ret = exynos_plane_init(drm, &ctx->plane, 0, &ctx->plane_config);
+	if (ret)
+		goto err_dma;
+
+	ctx->crtc = exynos_drm_crtc_create(drm, &ctx->plane.base,
+			EXYNOS_DISPLAY_TYPE_LCD, &decon_crtc_ops, ctx);
+	if (IS_ERR(ctx->crtc)) {
+		ret = PTR_ERR(ctx->crtc);
+		ctx->crtc = NULL;
+		goto err_dma;
+	}
+
+	return 0;
+
+err_dma:
+	exynos_drm_unregister_dma(drm, dev, &ctx->dma_priv);
+	return ret;
+}
+
+static void decon_unbind(struct device *dev, struct device *master, void *data)
+{
+	struct exynos8895_decon *ctx = dev_get_drvdata(dev);
+
+	if (ctx->active)
+		decon_atomic_disable(ctx->crtc);
+	exynos_drm_unregister_dma(ctx->drm_dev, dev, &ctx->dma_priv);
+}
+
+static const struct component_ops decon_component_ops = {
+	.bind = decon_bind,
+	.unbind = decon_unbind,
+};
+
+static int exynos8895_decon_runtime_resume(struct device *dev)
+{
+	struct exynos8895_decon *ctx = dev_get_drvdata(dev);
+
+	return clk_bulk_prepare_enable(DECON_NUM_CLKS, ctx->clks);
+}
+
+static int exynos8895_decon_runtime_suspend(struct device *dev)
+{
+	struct exynos8895_decon *ctx = dev_get_drvdata(dev);
+
+	clk_bulk_disable_unprepare(DECON_NUM_CLKS, ctx->clks);
+	return 0;
+}
+
+static DEFINE_RUNTIME_DEV_PM_OPS(exynos8895_decon_pm_ops,
+				 exynos8895_decon_runtime_suspend,
+				 exynos8895_decon_runtime_resume, NULL);
+
+static int exynos8895_decon_probe(struct platform_device *pdev)
+{
+	static const char * const clock_names[DECON_NUM_CLKS] = {
+		[DECON_ACLK] = "decon-aclk",
+		[DECON_PCLKM] = "decon-pclkm",
+		[DECON_PCLKS] = "decon-pclks",
+		[DPP_ACLK] = "dpp-aclk",
+		[DPP_PCLKM] = "dpp-pclkm",
+		[DPP_PCLKS] = "dpp-pclks",
+	};
+	struct device *dev = &pdev->dev;
+	struct exynos8895_decon *ctx;
+	struct resource *res;
+	int i, irq, ret;
+
+	ctx = devm_kzalloc(dev, sizeof(*ctx), GFP_KERNEL);
+	if (!ctx)
+		return -ENOMEM;
+	ctx->dev = dev;
+	platform_set_drvdata(pdev, ctx);
+
+	ret = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(32));
+	if (ret)
+		return dev_err_probe(dev, ret, "32-bit DMA is unavailable\n");
+
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "decon");
+	ctx->regs = devm_ioremap_resource(dev, res);
+	if (IS_ERR(ctx->regs))
+		return PTR_ERR(ctx->regs);
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "dpp");
+	ctx->dpp = devm_ioremap_resource(dev, res);
+	if (IS_ERR(ctx->dpp))
+		return PTR_ERR(ctx->dpp);
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "idma");
+	ctx->idma = devm_ioremap_resource(dev, res);
+	if (IS_ERR(ctx->idma))
+		return PTR_ERR(ctx->idma);
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "dma-common");
+	ctx->dma_common = devm_ioremap_resource(dev, res);
+	if (IS_ERR(ctx->dma_common))
+		return PTR_ERR(ctx->dma_common);
+
+	for (i = 0; i < DECON_NUM_CLKS; i++)
+		ctx->clks[i].id = clock_names[i];
+	ret = devm_clk_bulk_get(dev, DECON_NUM_CLKS, ctx->clks);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get DECON clocks\n");
+
+	ctx->sysreg = syscon_regmap_lookup_by_phandle(dev->of_node,
+						       "samsung,sysreg");
+	if (IS_ERR(ctx->sysreg))
+		return dev_err_probe(dev, PTR_ERR(ctx->sysreg),
+				     "failed to get DPU sysreg\n");
+
+	irq = platform_get_irq_byname(pdev, "frame-done");
+	if (irq < 0)
+		return irq;
+	ctx->irq = irq;
+	ret = devm_request_irq(dev, irq, decon_irq_handler, IRQF_NO_AUTOEN,
+			       dev_name(dev), ctx);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to request frame IRQ\n");
+
+	pm_runtime_enable(dev);
+	ret = device_create_file(dev, &dev_attr_decon_selftest);
+	if (ret) {
+		pm_runtime_disable(dev);
+		return ret;
+	}
+	ret = component_add(dev, &decon_component_ops);
+	if (ret) {
+		device_remove_file(dev, &dev_attr_decon_selftest);
+		pm_runtime_disable(dev);
+	}
+
+	return ret;
+}
+
+static void exynos8895_decon_remove(struct platform_device *pdev)
+{
+	device_remove_file(&pdev->dev, &dev_attr_decon_selftest);
+	component_del(&pdev->dev, &decon_component_ops);
+	pm_runtime_disable(&pdev->dev);
+}
+
+static const struct of_device_id exynos8895_decon_of_match[] = {
+	{ .compatible = "samsung,exynos8895-decon" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, exynos8895_decon_of_match);
+
+struct platform_driver exynos8895_decon_driver = {
+	.probe = exynos8895_decon_probe,
+	.remove = exynos8895_decon_remove,
+	.driver = {
+		.name = "exynos8895-decon",
+		.of_match_table = exynos8895_decon_of_match,
+		.pm = pm_ptr(&exynos8895_decon_pm_ops),
+	},
+};
