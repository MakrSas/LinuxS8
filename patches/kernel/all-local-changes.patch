+		      PHYRESUME_DIS_VBUSVALID_QACT | PHYRESUME_DIS_BVALID_QACT;
+		udelay(500);
+		writel(reg, phy_drd->reg_phy + EXYNOS5_DRD_PHYRESUME);
+		udelay(500);
+		reg |= PHYRESUME_FORCE_QACT;
+		writel(reg, phy_drd->reg_phy + EXYNOS5_DRD_PHYRESUME);
+
+		/* Pulse the link out of reset so it picks the new state up. */
