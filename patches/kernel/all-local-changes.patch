+	writel(0x00000000, dsi->reg_base + EXYNOS8895_DSIM_PLL_CTRL1);
+	writel(0x03800000, dsi->reg_base + EXYNOS8895_DSIM_PLL_CTRL2);
+	samsung_dsim_write(dsi, DSIM_PHYCTRL_REG, 0x000001c2);
+	writel(0x00000800, dsi->reg_base + EXYNOS8895_DSIM_PHYCTRL_B2);
+	writel(0x10001249, dsi->reg_base + EXYNOS8895_DSIM_PHYCTRL_B3);
+	writel(0x00500000, dsi->reg_base + EXYNOS8895_DSIM_PHYCTRL_B4);
+	writel(0x00001980, dsi->reg_base + EXYNOS8895_DSIM_PHYCTRL_M1);
+	writel(0x00000000, dsi->reg_base + EXYNOS8895_DSIM_PHYCTRL_M2);
+	writel(0x00000000, dsi->reg_base + EXYNOS8895_DSIM_PHYCTRL_M3);
+	writel(0x00000000, dsi->reg_base + EXYNOS8895_DSIM_PHYCTRL_M4);
+	samsung_dsim_write(dsi, DSIM_PHYTIMING_REG, 0x00000605);
+	samsung_dsim_write(dsi, DSIM_PHYTIMING1_REG, 0x080e0706);
+	samsung_dsim_write(dsi, DSIM_PHYTIMING2_REG, 0x0008050a);
