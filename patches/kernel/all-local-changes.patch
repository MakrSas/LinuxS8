+	pll = DSIM_PLL_EN | (5 << 13) | (691 << 3) | 2;
+	if (dsi->swap_dn_dp_clk)
+		pll |= DSIM_PLL_DPDNSWAP_CLK;
+	if (dsi->swap_dn_dp_data)
+		pll |= DSIM_PLL_DPDNSWAP_DAT;
+	samsung_dsim_write(dsi, DSIM_PLLCTRL_REG, pll);
+
+	ret = readl_poll_timeout(dsi->reg_base + EXYNOS8895_DSIM_LINK_STATUS3,
+				 reg, reg & EXYNOS8895_DSIM_PLL_STABLE,
+				 10, 20000);
