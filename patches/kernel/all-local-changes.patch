+	reg |= FIELD_PREP(PHYCLKRST_REFCLKSEL,
+			  phy_drd->drv_data->refclksel ? :
+			  PHYCLKRST_REFCLKSEL_EXT_REFCLK);
 
 	reg &= ~(PHYCLKRST_FSEL_UTMI |
 		 PHYCLKRST_MPLL_MULTIPLIER |
@@ -898,6 +931,31 @@ static int exynos5_usbdrd_phy_init(struct phy *phy)
 	writel(0x0, phy_drd->reg_phy + EXYNOS5_DRD_PHYREG0);
 	writel(0x0, phy_drd->reg_phy + EXYNOS5_DRD_PHYRESUME);
 
+	/*
+	 * Exynos8895 needs the Q-Channel handshake switched off before
+	 * anything else, otherwise the block quiesces, its clocks stop and
+	 * every controller command times out ("failed to enable ep0out").
+	 * The delays and the ordering are the vendor's: the disable bits
+	 * have to land before Q-active is forced.
