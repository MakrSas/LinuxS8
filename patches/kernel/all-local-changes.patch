+	.tx_trailingclks		= 0x10,
+	.pa_dbg_opt_suite1_val		= 0x2e820183,
+	.pa_dbg_opt_suite1_off		= PA_DBG_OPTION_SUITE,
+};
+
+static const struct exynos_ufs_drv_data exynos8895_ufs_drvs = {
+	.uic_attr		= &exynos8895_uic_attr,
+	/*
+	 * Набор как у gs101. Существенно отсутствие UFSHCI_QUIRK_BROKEN_HCE:
+	 * даунстрим включает обход HCE (UFSHCD_QUIRK_USE_OF_HCE) только для
+	 * hw_rev == UFS_VER_0003, то есть для Exynos8890. У 8895 контроллер
+	 * поднимается штатной записью HCE, а не парой DME_RESET/DME_ENABLE.
+	 */
+	.quirks			= UFSHCD_QUIRK_PRDT_BYTE_GRAN |
+				  UFSHCI_QUIRK_BROKEN_REQ_LIST_CLR |
+				  UFSHCI_QUIRK_SKIP_RESET_INTR_AGGR |
+				  UFSHCD_QUIRK_BROKEN_OCS_FATAL_ERROR |
+				  UFSHCI_QUIRK_SKIP_MANUAL_WB_FLUSH_CTRL |
+				  UFSHCD_QUIRK_SKIP_DEF_UNIPRO_TIMEOUT_SETTING,
+	/*
+	 * EXYNOS_UFS_OPT_BROKEN_RX_SEL_IDX убран, и это не косметика: с ним
+	 * rx_sel_idx = 0, то есть все атрибуты PCS RX уходили с селектором
+	 * линии 0..1 — в передатчик. У даунстрима RX_LANE_0 = 4, ровно как в
+	 * mainline по умолчанию (PA_MAXDATALANES).
+	 *
+	 * EXYNOS_UFS_OPT_HAS_APB_CLK_CTRL нужен, чтобы заработал делитель
+	 * pclk: без него частота PCS считается вдвое выше настоящей (см.
+	 * pclk-freq-avail-range в dts).
+	 *
+	 * EXYNOS_UFS_OPT_TIMER_TICK_SELECT — то же, что IA_TICK_SEL в
+	 * exynos_ufs_fit_aggr_timeout() даунстрима для hw_rev >= 0004.
+	 */
+	.opts			= EXYNOS_UFS_OPT_HAS_APB_CLK_CTRL |
+				  EXYNOS_UFS_OPT_BROKEN_AUTO_CLK_CTRL |
+				  EXYNOS_UFS_OPT_SKIP_CONNECTION_ESTAB |
+				  EXYNOS_UFS_OPT_SKIP_CONFIG_PHY_ATTR |
+				  EXYNOS_UFS_OPT_TIMER_TICK_SELECT |
+				  EXYNOS_UFS_OPT_UPMCRS_IN_UNIPRO |
+				  EXYNOS_UFS_OPT_UFSPR_SECURE,
+	.pre_link		= exynos8895_ufs_pre_link,
+	.post_link		= exynos8895_ufs_post_link,
+	.pre_pwr_change		= exynos8895_ufs_pre_pwr_change,
+};
