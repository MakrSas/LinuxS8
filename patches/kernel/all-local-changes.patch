+ * та же стена, что у vqmmc карты памяти. Регуляторное ядро подставит
+ * заглушку, и probe это не остановит; включена ли линия на самом деле,
+ * узнаем по тому, читается ли GPU_ID.
+ */
+&gpu {
+	status = "okay";
 };
 
