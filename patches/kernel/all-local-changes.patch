+	/* Linux owns a disabled IRQ at this point; also quiesce S-Boot's mask. */
+	samsung_dsim_write(dsi, DSIM_INTMSK_REG, 0xffffffff);
+	samsung_dsim_write(dsi, DSIM_INTSRC_REG, 0xffffffff);
+
+	/* DSIM0 -> D-PHY0, matching Samsung's DPU LPMUX setup. */
+	ret = regmap_write(dsi->sysreg, 0, 0x1201);
+	if (ret)
+		return ret;
