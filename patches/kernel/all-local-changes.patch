+ * PCIe для 8895 в мейнлайне нет вовсе.
+ */
+&usbdrd_phy {
+	status = "okay";
+};
+
+&usbdrd {
+	status = "okay";
+};
+
+&ufs_phy {
+	status = "okay";
+};
+
+&ufs {
+	vcc-supply = <&reg_ufs_vcc>;
+	status = "okay";
+};
