+/*
+ * Exynos8895 отличается от exynos7 ровно одним, но фатально: блок защиты
+ * UFS (UFSP, он же SMU) принадлежит защищённому миру. Чтение его регистров
+ * из EL1 отдаёт нули, а ЗАПИСЬ поднимает асинхронный внешний аборт:
+ *
+ *   SError Interrupt on CPU5, code 0x00000000bf000002
+ *   pc : exynos_ufs_config_smu+0xc0/0xe8 [ufs_exynos]
+ *   Kernel panic - not syncing: Asynchronous SError Interrupt
+ *   SMP: stopping secondary CPUs
+ *
+ * Именно это всё время выглядело как "телефон намертво завис в случайном
+ * месте": ядро паниковало, гасило остальные ядра, а вывод паники не успевал
+ * дойти до fbcon.
+ *
+ * EXYNOS_UFS_OPT_UFSPR_SECURE ровно для такого случая и заведён — с ним
+ * exynos_ufs_config_smu() не трогает UFSP вообще, а FMP инициализируется
+ * через SMC, как это уже сделано для gs101.
+ */
+/*
+ * Своя настройка линка для Exynos8895.
+ *
+ * Почему не подошла exynos7_ufs_pre_link: она вся построена вокруг
+ * PA_DBG_OV_TM (0x9540) — вендорского «режима отладочного доступа»
+ * Exynos7420. На этом чипе такого атрибута нет, UniPro отвечает на него
+ * кодом 1 (INVALID_MIB_ATTRIBUTE), и следом отвергаются все тестовые
+ * атрибуты M-PHY, которые за ним идут.
+ *
+ * Первая версия этой функции была срисована с gs101_ufs_pre_link и все
+ * записи прошли (ни одного ret=1), но DME_LINK_STARTUP всё равно не
+ * завершался. Теперь последовательность взята из вендорского ядра для
+ * universal8895, где она лежит в dts узла ufs — свойство phy-init, записи с
+ * типами UNIPRO_DBG_PRD, PHY_PCS_* и UNIPRO_*_MIB (записи PHY_PMA_* оттуда
+ * же уехали в phy-exynos8895-ufs.c). Отличий от gs101 три, и каждое важно:
+ *
+ *  - период такта PCS берётся от pclk, а не от mclk, и НЕ округляется вверх:
+ *    даунстрим считает его как NSEC_PER_SEC / pclk_rate. У нас pclk после
+ *    деления на 2 (см. pclk-freq-avail-range в dts) равен 83.28 МГц, то есть
+ *    12 нс, тогда как формула gs101 дала бы 7;
+ *  - line reset здесь вообще не программируется — вендор его не трогает;
+ *  - зато есть восемь точечных настроек PCS, которых у gs101 нет (и его
+ *    собственные 0x2f/0x25 сюда, наоборот, не годятся).
+ */
+static int exynos8895_ufs_pre_link(struct exynos_ufs *ufs)
+{
+	struct ufs_hba *hba = ufs->hba;
+	u32 pcs_clk_period = UNIPRO_PCLK_PERIOD(ufs);
+	u32 val;
+	int i;
+
+
+	/*
+	 * HWACG у 8895 после сброса разрешён, и по прямому указанию
+	 * даунстрима ("need to set 1 (disable HWACG) during UFS init") его
+	 * надо выключить на время инициализации: иначе автоматика гасит
+	 * тактирование блока прямо посреди настройки.
+	 */
+	val = hci_readl(ufs, HCI_UFS_ACG_DISABLE);
+	hci_writel(ufs, val | HCI_UFS_ACG_DISABLE_EN, HCI_UFS_ACG_DISABLE);
+
+	/*
+	 * Мультиплексор опорного такта M-PHY: даунстрим выбирает
+	 * альтернативный путь (exynos_ufs_select_refclk(ufs, true), ветка
+	 * ровно для hw_rev == UFS_VER_0004, то есть для 8895). Без опорного
+	 * такта PLL передатчика не захватится, и DME_LINK_STARTUP не
+	 * завершится никогда — что мы и наблюдали.
+	 */
+	val = hci_readl(ufs, HCI_MPHY_REFCLK_SEL);
+	hci_writel(ufs, val | MPHY_REFCLK_SEL, HCI_MPHY_REFCLK_SEL);
+
+	/*
+	 * Период такта UniPro. Считается от mclk и, в отличие от общей
+	 * exynos_ufs_config_unipro(), без округления вверх: при 166.5625 МГц
+	 * даунстрим пишет 6, а DIV_ROUND_UP дал бы 7. Поэтому в
+	 * exynos8895_uic_attr поле pa_dbg_clk_period_off оставлено нулём —
+	 * общая функция этот атрибут не трогает, и он пишется здесь.
+	 */
+	ufshcd_dme_set(hba, UIC_ARG_MIB(PA_DBG_CLK_PERIOD),
+		       NSEC_PER_SEC / ufs->mclk_rate);
+
+	/* открыть доступ к вендорским атрибутам M-PHY */
+	ufshcd_dme_set(hba, UIC_ARG_MIB(0x200), 0x40);
+
+	for_each_ufs_rx_lane(ufs, i) {
+		ufshcd_dme_set(hba, UIC_ARG_MIB_SEL(VND_RX_CLK_PRD, i),
+			       pcs_clk_period);
+		ufshcd_dme_set(hba, UIC_ARG_MIB_SEL(0x5c, i), 0x38);
+		ufshcd_dme_set(hba, UIC_ARG_MIB_SEL(0x0f, i), 0x00);
+		/* INT_H8_COUNT_CAP_ENABLE: THIBERN8 CAPABILITY (200 us) */
+		ufshcd_dme_set(hba, UIC_ARG_MIB_SEL(0x65, i), 0x01);
+		ufshcd_dme_set(hba, UIC_ARG_MIB_SEL(0x69, i), 0x01);
+		ufshcd_dme_set(hba, UIC_ARG_MIB_SEL(0x21, i), 0x00);
+		ufshcd_dme_set(hba, UIC_ARG_MIB_SEL(0x22, i), 0x00);
+		ufshcd_dme_set(hba, UIC_ARG_MIB_SEL(0x84, i), 0x01);
+	}
+
+	for_each_ufs_tx_lane(ufs, i) {
+		ufshcd_dme_set(hba, UIC_ARG_MIB_SEL(VND_TX_CLK_PRD, i),
+			       pcs_clk_period);
+		ufshcd_dme_set(hba, UIC_ARG_MIB_SEL(0x04, i), 0x01);
+	}
+
+	/* закрыть вендорский доступ */
+	ufshcd_dme_set(hba, UIC_ARG_MIB(0x200), 0x0);
+
+	ufshcd_dme_set(hba, UIC_ARG_MIB(PA_DBG_AUTOMODE_THLD), 0x4e20);
+	ufshcd_dme_set(hba, UIC_ARG_MIB(PA_LOCAL_TX_LCC_ENABLE), 0x0);
+
+	/*
+	 * Установка соединения. У даунстрима exynos_ufs_establish_connt()
+	 * для hw_rev >= UFS_VER_0004 выходит сразу, а эти четыре атрибута
+	 * пишутся здесь, до старта линка — как и у gs101.
+	 */
+	ufshcd_dme_set(hba, UIC_ARG_MIB(N_DEVICEID), 0x0);
+	ufshcd_dme_set(hba, UIC_ARG_MIB(N_DEVICEID_VALID), 0x1);
+	ufshcd_dme_set(hba, UIC_ARG_MIB(T_PEERDEVICEID), 0x1);
+	ufshcd_dme_set(hba, UIC_ARG_MIB(T_CONNECTIONSTATE), CPORT_CONNECTED);
+
+	return 0;
+}
+
+/*
+ * После старта линка: вендорское свойство post-phy-init.
+ */
+static int exynos8895_ufs_post_link(struct exynos_ufs *ufs)
+{
+	struct ufs_hba *hba = ufs->hba;
+	int i;
+
+
+	exynos_ufs_enable_dbg_mode(hba);
+	ufshcd_dme_set(hba, UIC_ARG_MIB(PA_SAVECONFIGTIME), 0xfa);
+	exynos_ufs_disable_dbg_mode(hba);
+
+	ufshcd_dme_set(hba, UIC_ARG_MIB(0x200), 0x40);
+	for_each_ufs_rx_lane(ufs, i) {
+		ufshcd_dme_set(hba, UIC_ARG_MIB_SEL(0x35, i), 0x05);
+		ufshcd_dme_set(hba, UIC_ARG_MIB_SEL(0x73, i), 0x01);
+		ufshcd_dme_set(hba, UIC_ARG_MIB_SEL(0x41, i), 0x02);
+		ufshcd_dme_set(hba, UIC_ARG_MIB_SEL(0x42, i), 0xac);
+	}
+	ufshcd_dme_set(hba, UIC_ARG_MIB(0x200), 0x0);
+
+	return 0;
+}
