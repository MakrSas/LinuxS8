+	samsung_dsim_write(dsi, DSIM_SFRCTRL_REG,
+			   DSIM_SFR_CTRL_SHADOW_UPDATE |
+			   DSIM_SFR_CTRL_SHADOW_EN);
+
+	/* Request HS first, as in Samsung's CAL start sequence. */
+	reg = samsung_dsim_read(dsi, DSIM_CLKCTRL_REG);
+	reg |= EXYNOS8895_DSIM_HSCLK_REQ;
+	samsung_dsim_write(dsi, DSIM_CLKCTRL_REG, reg);
+
+	/* Clear stale state and unmask only the interrupts used by this driver. */
+	irq_unmask = DSIM_INT_SW_RST_RELEASE |
+		     DSIM_INT_SFR_FIFO_EMPTY |
+		     DSIM_INT_SFR_HDR_FIFO_EMPTY |
+		     DSIM_INT_FRAME_DONE | BIT(23) | BIT(19) |
+		     DSIM_INT_RX_DONE | DSIM_INT_RX_ECC_ERR | BIT(13);
+	samsung_dsim_write(dsi, DSIM_INTSRC_REG, 0xffffffff);
+	samsung_dsim_enable_irq(dsi);
+	samsung_dsim_write(dsi, DSIM_INTMSK_REG, ~irq_unmask);
+
+	dsi->state |= DSIM_STATE_INITIALIZED;
+	dev_info(dsi->dev, "Exynos8895 DSIM initialized at 898 MHz\n");
+	return 0;
