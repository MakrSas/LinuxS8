diff --git a/arch/arm64/boot/dts/exynos/exynos8895-dreamlte.dts b/arch/arm64/boot/dts/exynos/exynos8895-dreamlte.dts
index 305dc72f9..e63f5b818 100644
--- a/arch/arm64/boot/dts/exynos/exynos8895-dreamlte.dts
+++ b/arch/arm64/boot/dts/exynos/exynos8895-dreamlte.dts
@@ -26,6 +26,18 @@ chosen {
 		#size-cells = <1>;
 		ranges;
 
+		/*
+		 * Bring-up crutch, not a permanent fix: S-Boot leaves FSYS0
+		 * clocks/domains on (it just loaded us off UFS), then the
+		 * kernel's late clk_disable_unused/genpd cleanup switches them
+		 * back off because no mainline driver claims them yet. Proof:
+		 * reading sysreg_fsys0 (0x11020700) from userspace after boot
+		 * gives a bus error, while CMU_FSYS0 itself still reads fine.
+		 * Drop these once the UFS/USB blocks properly claim their
+		 * clocks and power domains.
+		 */
+		bootargs = "clk_ignore_unused pd_ignore_unused console=ttySAC0,115200 console=tty0";
+
 		framebuffer: framebuffer@cc000000 {
 			compatible = "simple-framebuffer";
 			reg = <0 0xcc000000 (1440 * 2960 * 4)>;
@@ -48,11 +60,20 @@ reserved-memory {
 		#size-cells = <1>;
 		ranges;
 
+		/*
+		 * Enlarged from the upstream 0x8000 and given a pmsg area: the
+		 * framebuffer console is our only output, so when a driver
+		 * wedges the display we go blind even if the kernel is still
+		 * running. ramoops survives a warm reset, so the next boot can
+		 * read back both the kernel log and userspace markers written
+		 * to /dev/pmsg0 from the boot that appeared to hang.
+		 */
 		ramoops@92000000 {
 			compatible = "ramoops";
-			reg = <0 0x92000000 0x8000>;
+			reg = <0 0x92000000 0x20000>;
 			record-size = <0x4000>;
-			console-size = <0x4000>;
+			console-size = <0x10000>;
+			pmsg-size = <0x4000>;
 		};
 
 		cont_splash_mem: framebuffer@cc000000 {
@@ -100,6 +121,72 @@ reg_placeholder: regulator-0 {
 		compatible = "regulator-fixed";
 		regulator-name = "reg-placeholder";
 	};
+
+	/*
+	 * SD card VMMC. This one is real: downstream drives it from a GPIO
+	 * load switch, not the PMIC. Confirmed empirically by dumping the
+	 * running downstream kernel's state from TWRP --
+	 * /sys/kernel/debug/gpio showed "gpio-121 (vmmc) out hi", and the
+	 * bank table puts GPIOs 120-123 on gpb1, so vmmc is gpb1-1.
+	 * Without it the controller inits fine but the card never answers,
+	 * and dw_mmc just walks 400k->300k->200k->100k and gives up.
+	 */
+	reg_sdcard_vmmc: regulator-1 {
+		compatible = "regulator-fixed";
+		regulator-name = "vmmc";
+		regulator-min-microvolt = <2800000>;
+		regulator-max-microvolt = <2800000>;
+		gpio = <&gpb1 1 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		regulator-boot-on;
+	};
+
+	/*
+	 * SD card VQMMC (bus I/O level). Downstream drives this from an
+	 * actual S2MPS17 LDO, which mainline cannot reach -- there is no
+	 * S2MPS17 driver and no SPEEDY bus driver upstream. uniLoader
+	 * already switches that LDO on to 2.8V before handing over, so
+	 * model it as a fixed always-on rail at the voltage uniLoader sets.
+	 * This is why UHS modes stay off: switching to 1.8V for SDR50/104
+	 * needs real control over that LDO.
+	 */
+	reg_sdcard_vqmmc: regulator-3 {
+		compatible = "regulator-fixed";
+		regulator-name = "vqmmc-fixed";
+		regulator-min-microvolt = <2800000>;
+		regulator-max-microvolt = <2800000>;
+		regulator-always-on;
+	};
+
+	/* Real GPIO-controlled rail (confirmed against downstream source,
+	 * gpg0-0 active-high) — unlike touchscreen/sdcard this isn't a PMIC
+	 * rail, so this one should actually power the chip for real. */
+	reg_ufs_vcc: regulator-2 {
+		compatible = "regulator-fixed";
+		regulator-name = "reg-ufs-vcc";
+		gpio = <&gpg0 0 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		regulator-boot-on;
+	};
+};
+
+/*
+ * PHY isolation lives at PMU offset 0x724 on Exynos8895, not the 0x720 the
+ * exynos7-ufs-phy driver defaults to; the offset is overridden on the
+ * ufs_phy node in exynos8895.dtsi.
+ *
+ * 2026-08-08: that node no longer borrows Exynos7420's PHY template. It now
+ * uses samsung,exynos8895-ufs-phy with the PMA calibration table lifted from
+ * the vendor kernel (see drivers/phy/samsung/phy-exynos8895-ufs.c) and a
+ * single real ref_clk instead of four placeholder &oscclk entries.
+ */
+&ufs_phy {
+	status = "okay";
+};
+
+&ufs {
+	vcc-supply = <&reg_ufs_vcc>;
+	status = "okay";
 };
 
 &hsi2c_23 {
@@ -129,19 +216,56 @@ &mmc {
 	pinctrl-0 = <&sd2_clk &sd2_cmd &sd2_bus1 &sd2_bus4 &sd2_cd>;
 	pinctrl-names = "default";
 
+	/*
+	 * PIO was tried and ruled out: forcing TRANS_MODE_PIO (see the
+	 * fifo-mode handling added to dw_mmc.c) failed data transfers just
+	 * the same, so the 64-bit IDMAC engine was never the problem. Left
+	 * on the default DMA path.
+	 */
 	bus-width = <4>;
+
+	/*
+	 * Not set by dw_mmc-exynos, only ever from DT -- without it
+	 * mmc_sd_switch_hs() never runs and the card is pinned to its
+	 * csd.max_dtr of 25 MHz.
+	 */
+	cap-sd-highspeed;
+
 	card-detect-delay = <200>;
 	cd-gpios = <&gpa1 5 GPIO_ACTIVE_LOW>;
 	clock-frequency = <800000000>;
 	disable-wp;
-	sd-uhs-sdr50;
-	sd-uhs-sdr104;
-
-	/* TODO: Add regulators once PMIC is implemented */
+	/* UHS voltage switching (SDR50/SDR104) needs a real, switchable
+	 * vqmmc regulator — reg_placeholder is a bare always-on fixed
+	 * regulator, not voltage-adjustable. Drop UHS for now so we don't
+	 * depend on that; plain high-speed still gives working storage. */
+
+	vmmc-supply = <&reg_sdcard_vmmc>;
+	vqmmc-supply = <&reg_sdcard_vqmmc>;
+
+	/*
+	 * Without pinning the divider the SoC dtsi's mux-only assignment
+	 * leaves CIU at 666.25/4 = 166.5625 MHz, so bus_hz lands on the odd
+	 * 41.64 MHz seen in dmesg. shared2_pll is exactly 800 MHz, giving
+	 * CIU 200 MHz and bus_hz 50 MHz -- the same operating point the
+	 * vendor kernel uses, which is what makes its tuned phase values
+	 * below mean the same thing here.
+	 */
+	assigned-clocks = <&cmu_top CLK_MOUT_CMU_FSYS1_MMC_CARD>,
+			  <&cmu_top CLK_DOUT_CMU_FSYS1_MMC_CARD>;
+	assigned-clock-parents = <&cmu_top CLK_FOUT_SHARED2_PLL>, <0>;
+	assigned-clock-rates = <0>, <800000000>;
 
 	samsung,dw-mshc-ciu-div = <3>;
 	samsung,dw-mshc-ddr-timing = <1 2>;
-	samsung,dw-mshc-sdr-timing = <0 3>;
+	/*
+	 * SDMMC_CLKSEL_TIMING() packs these as sample=timing[0],
+	 * drive=timing[1] -- the opposite of what the binding's "tx/rx"
+	 * wording suggests. The vendor kernel's tuning log prints
+	 * CLKSEL = 0x03030003, i.e. sample=3 drive=3, so <0 3> (sample=0)
+	 * was wrong here.
+	 */
+	samsung,dw-mshc-sdr-timing = <3 3>;
 
 	status = "okay";
 };
@@ -194,3 +318,24 @@ &usi9 {
 	samsung,mode = <USI_MODE_I2C0_1>;
 	status = "okay";
 };
+
+/*
+ * exynos8895-pinctrl.dtsi leaves the SD card's CMD and DAT lines at
+ * PULL_NONE, which no other Exynos in-tree does (exynos7420, exynos5433 and
+ * exynos7870 all pull the DAT lines up, and the vendor kernels use pud=3
+ * universally for sd2). Floating DAT lines fit the observed failure exactly:
+ * short reads during card identification succeed, but every 512-byte sector
+ * read fails -- with CRC errors at 20.8 MHz and with no start bit seen at
+ * all at 3.47 MHz.
+ */
+&sd2_cmd {
+	samsung,pin-pud = <EXYNOS_PIN_PULL_UP>;
+};
+
+&sd2_bus1 {
+	samsung,pin-pud = <EXYNOS_PIN_PULL_UP>;
+};
+
+&sd2_bus4 {
+	samsung,pin-pud = <EXYNOS_PIN_PULL_UP>;
+};
diff --git a/arch/arm64/boot/dts/exynos/exynos8895.dtsi b/arch/arm64/boot/dts/exynos/exynos8895.dtsi
index ff114cd6c..a21e68814 100644
--- a/arch/arm64/boot/dts/exynos/exynos8895.dtsi
+++ b/arch/arm64/boot/dts/exynos/exynos8895.dtsi
@@ -1433,6 +1433,18 @@ mmc: mmc@11500000 {
 			clocks = <&cmu_fsys1 CLK_GOUT_FSYS1_MMC_CARD_I_ACLK>,
 				 <&cmu_fsys1 CLK_GOUT_FSYS1_MMC_CARD_SDCLKIN>;
 			clock-names = "biu", "ciu";
+			/*
+			 * Declared rather than autodetected: the driver's
+			 * fallback infers the depth from the reset value of
+			 * FIFOTH's RX_WMark field, which only holds if no
+			 * bootloader ever wrote that register.
+			 *
+			 * This value does not bear on the sector-read DRTO.
+			 * dw_mci_ctrl_thld() programs CDTHRCTL only for
+			 * HS200/SDR104/HS400 and writes 0 for everything
