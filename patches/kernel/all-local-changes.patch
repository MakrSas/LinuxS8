+			samsung_dsim_write(dsi, DSIM_INTSRC_REG, 0xffffffff);
+			samsung_dsim_disable_irq(dsi);
+			samsung_dsim_disable_clock(dsi);
+		} else {
+			samsung_dsim_disable_clock(dsi);
+			samsung_dsim_disable_irq(dsi);
+		}
 	}
 
 	dsi->state &= ~DSIM_STATE_CMD_LPM;
