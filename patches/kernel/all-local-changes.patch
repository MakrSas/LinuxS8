+/*
+ * USB-C CC/MUIC (S2MM005) is on the second I2C controller of USI12,
+ * hsi2c_30, at 0x33.  Bring up the bus by itself first: the first test
+ * must be a read/scan from userspace, not a guessed switch write.
+ */
+&usi12 {
+	samsung,mode = <USI_MODE_I2C1>;
+	status = "okay";
+};
+
+&hsi2c_30 {
+	status = "okay";
+
+	/*
+	 * The vendor board file configures all three CCIC-related pins before
+	 * binding s2mm005: OM=1 (normal firmware mode), the CCIC interrupt as
+	 * an external falling-edge input, and USB3.1_CON_SEL with a pull-up.
+	 * Keep that electrical setup in DT; the first mainline driver below is
+	 * deliberately diagnostic and does not guess at the switch state.
+	 */
+	s2mm005: usbpd-s2mm005@33 {
+		compatible = "samsung,s2mm005";
+		reg = <0x33>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&s2mm005_om &s2mm005_irq &s2mm005_con_sel>;
+
+		interrupt-parent = <&gpa1>;
+		interrupts = <7 IRQ_TYPE_LEVEL_LOW>;
+	};
+};
+
+/* Vendor MUIC (max77854/max77865) is hsi2c_32 at 0x66 inside USI13. */
