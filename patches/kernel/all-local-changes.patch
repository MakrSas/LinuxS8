@@ -1830,7 +1830,39 @@ static int dw_mci_data_complete(struct dw_mci *host, struct mmc_data *data)
 			data->error = -EILSEQ;
 		}
 
-		dev_dbg(host->dev, "data error, status 0x%08x\n", status);
+		/*
+		 * The opcode and R1 separate a host-side fault from the card
+		 * refusing the transfer: R1 bit 25 CARD_IS_LOCKED, bit 31
+		 * OUT_OF_RANGE, bit 30 ADDRESS_ERROR, and the current state in
+		 * bits 12:9 (4 == tran) are all invisible otherwise, because
+		 * dw_mmc never inspects the response of a data command.
+		 */
+		dev_err(host->dev, "data err %08x cmd%u arg %08x r1 %08x\n",
+			status, data->mrq->cmd->opcode, data->mrq->cmd->arg,
+			data->mrq->cmd->resp[0]);
+
+		/*
+		 * TCBCNT/TBBCNT are the only witnesses to whether any data
+		 * crossed the card interface at all: TCBCNT counts bytes the
+		 * CIU moved to/from the card, TBBCNT bytes the BIU moved
+		 * to/from the FIFO. Both have to be sampled here, before the
+		 * dw_mci_reset() below clears them. DRTO with tcb == 0 means
+		 * the card never drove a start bit; tcb == blksz would mean it
+		 * sent the block and the timeout has some other cause.
