diff --git a/drivers/power/supply/max77865_battery.c b/drivers/power/supply/max77865_battery.c
new file mode 100644
index 000000000..f810680f2
--- /dev/null
+++ b/drivers/power/supply/max77865_battery.c
@@ -0,0 +1,430 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Read-only power-supply monitor for the MAX77854/MAX77865 used by
+ * Exynos8895 phones.
+ *
+ * The vendor PMIC exposes the charger and fuel gauge through secondary I2C
+ * addresses.  This driver deliberately reports state only: charging policy
+ * and register programming remain owned by the firmware/userspace path until
+ * a complete charger driver is ready.
+ */
+
+#include <linux/delay.h>
+#include <linux/i2c.h>
+#include <linux/kernel.h>
+#include <linux/math64.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/power_supply.h>
+#include <linux/property.h>
+#include <linux/workqueue.h>
+
+#define MAX77865_I2C_CHARGER	0x69 /* vendor 0xd2 >> 1 */
+#define MAX77865_I2C_FUELGAUGE	0x36 /* vendor 0x6c >> 1 */
+
+#define MAX77865_REG_PMIC_ID		0x00
+
+#define MAX77865_REG_FG_STATUS		0x00
+#define MAX77865_REG_FG_REPSOC		0x06
+#define MAX77865_REG_FG_TEMPERATURE	0x08
+#define MAX77865_REG_FG_VCELL		0x09
+#define MAX77865_REG_FG_CURRENT		0x0a
+#define MAX77865_REG_FG_AVG_CURRENT	0x0b
+#define MAX77865_REG_FG_CYCLES		0x17
+#define MAX77865_REG_FG_REMCAP_REP	0x05
+
+#define MAX77865_REG_CHG_DETAILS_00	0xb3
+#define MAX77865_REG_CHG_DETAILS_01	0xb4
+#define MAX77865_REG_CHG_INT_OK		0xb2
+
+#define MAX77865_CHGIN_DTLS		0x60
+#define MAX77865_CHGIN_DTLS_SHIFT	5
+#define MAX77865_CHG_DTLS		0x0f
+
+#define MAX77865_POLL_MS		2000
+
+struct max77865_power {
+	struct device *dev;
+	struct i2c_client *pmic;
+	struct i2c_client *charger;
+	struct i2c_client *fuelgauge;
+	struct power_supply *battery;
+	struct power_supply *usb;
+	struct delayed_work poll_work;
+	struct mutex lock;
+};
+
+static int max77865_read8(struct i2c_client *client, u8 reg, u8 *value)
+{
+	int ret = i2c_smbus_read_byte_data(client, reg);
+
+	if (ret < 0)
+		return ret;
+
+	*value = ret;
+	return 0;
+}
+
+static int max77865_read16(struct i2c_client *client, u8 reg, u16 *value)
+{
+	int ret = i2c_smbus_read_word_data(client, reg);
+
+	if (ret < 0)
+		return ret;
+
+	*value = ret;
+	return 0;
+}
+
+static int max77865_read_vbus_state(struct max77865_power *data)
+{
+	u8 details;
+	int ret;
+
+	ret = max77865_read8(data->charger, MAX77865_REG_CHG_DETAILS_00,
+			     &details);
+	if (ret)
+		return ret;
+
+	return (details & MAX77865_CHGIN_DTLS) >> MAX77865_CHGIN_DTLS_SHIFT;
+}
+
+static int max77865_read_charger_status(struct max77865_power *data)
+{
+	u8 details;
+	int ret;
+
+	ret = max77865_read8(data->charger, MAX77865_REG_CHG_DETAILS_01,
+			     &details);
+	if (ret)
+		return ret;
+
+	switch (details & MAX77865_CHG_DTLS) {
+	case 0x00:
+	case 0x01:
+	case 0x02:
+		return POWER_SUPPLY_STATUS_CHARGING;
+	case 0x03:
+	case 0x04:
+		return POWER_SUPPLY_STATUS_FULL;
+	case 0x05:
+	case 0x06:
+	case 0x07:
+		return POWER_SUPPLY_STATUS_NOT_CHARGING;
+	case 0x08:
+	case 0x0a:
+	case 0x0b:
+		return POWER_SUPPLY_STATUS_DISCHARGING;
+	default:
+		return POWER_SUPPLY_STATUS_UNKNOWN;
+	}
+}
+
+static int max77865_read_capacity(struct max77865_power *data)
+{
+	u16 raw;
+	int ret;
+
+	ret = max77865_read16(data->fuelgauge, MAX77865_REG_FG_REPSOC, &raw);
+	if (ret)
+		return ret;
+
+	/* RepSOC is a 16-bit percentage: high byte is 1%, low byte fractional. */
+	return min_t(int, 100, DIV_ROUND_CLOSEST((int)raw, 256));
+}
+
+static int max77865_read_voltage_uv(struct max77865_power *data, int *uv)
+{
+	u16 raw;
+	int ret;
+
+	ret = max77865_read16(data->fuelgauge, MAX77865_REG_FG_VCELL, &raw);
+	if (ret)
+		return ret;
+
+	/* MAX172xx-style VCELL LSB is 78.125 uV; raw * 78125 overflows int. */
+	*uv = div_u64((u64)raw * 78125, 1000);
+	return 0;
+}
+
+static int max77865_read_current_ua(struct max77865_power *data, u8 reg,
+				    int *ua)
+{
+	u16 raw;
+	int ret;
+
+	ret = max77865_read16(data->fuelgauge, reg, &raw);
+	if (ret)
+		return ret;
+
+	/* Vendor calibration uses a 10 mOhm sense resistor. */
+	*ua = (s16)raw * 15625 / 100;
+	return 0;
+}
+
+static int max77865_read_temperature(struct max77865_power *data, int *temp)
+{
+	u16 raw;
+	int ret;
+	int temperature;
+	u8 high, low;
+
+	ret = max77865_read16(data->fuelgauge, MAX77865_REG_FG_TEMPERATURE,
+			     &raw);
+	if (ret)
+		return ret;
+
+	low = raw & 0xff;
+	high = raw >> 8;
+	if (high & BIT(7)) {
+		temperature = -(((~high & 0xff) + 1) * 1000);
+		temperature -= ((~low + 1) & 0xff) * 39 / 10;
+	} else {
+		temperature = (high & 0x7f) * 1000;
+		temperature += low * 39 / 10;
+	}
+
+	/* power_supply temperature is in tenths of a degree Celsius. */
+	*temp = temperature / 100;
+	return 0;
+}
+
+static int max77865_battery_get_property(struct power_supply *psy,
+					 enum power_supply_property property,
+					 union power_supply_propval *value)
+{
+	struct max77865_power *data = power_supply_get_drvdata(psy);
+	int vbus, ret;
+	u8 fg_status;
+	u16 raw;
+
+	mutex_lock(&data->lock);
+
+	switch (property) {
+	case POWER_SUPPLY_PROP_STATUS:
+		ret = max77865_read_charger_status(data);
+		if (ret < 0)
+			goto out;
+		value->intval = ret;
+		ret = 0;
+		break;
+	case POWER_SUPPLY_PROP_HEALTH:
+		vbus = max77865_read_vbus_state(data);
+		if (vbus < 0) {
+			ret = vbus;
+			goto out;
+		}
+		value->intval = vbus == 0x02 ? POWER_SUPPLY_HEALTH_OVERVOLTAGE :
+					POWER_SUPPLY_HEALTH_GOOD;
+		ret = 0;
+		break;
+	case POWER_SUPPLY_PROP_PRESENT:
+		ret = max77865_read8(data->fuelgauge, MAX77865_REG_FG_STATUS,
+				     &fg_status);
+		if (ret)
+			goto out;
+		value->intval = !(fg_status & BIT(3));
+		break;
+	case POWER_SUPPLY_PROP_ONLINE:
+		ret = max77865_read_vbus_state(data);
+		if (ret < 0)
+			goto out;
+		value->intval = ret == 0x03;
+		ret = 0;
+		break;
+	case POWER_SUPPLY_PROP_TECHNOLOGY:
+		value->intval = POWER_SUPPLY_TECHNOLOGY_LION;
+		ret = 0;
+		break;
+	case POWER_SUPPLY_PROP_VOLTAGE_NOW:
+		ret = max77865_read_voltage_uv(data, &value->intval);
+		break;
+	case POWER_SUPPLY_PROP_CURRENT_NOW:
+		ret = max77865_read_current_ua(data, MAX77865_REG_FG_CURRENT,
+					       &value->intval);
+		break;
+	case POWER_SUPPLY_PROP_CURRENT_AVG:
+		ret = max77865_read_current_ua(data, MAX77865_REG_FG_AVG_CURRENT,
+					       &value->intval);
+		break;
+	case POWER_SUPPLY_PROP_CAPACITY:
+		ret = max77865_read_capacity(data);
+		if (ret < 0)
+			goto out;
+		value->intval = ret;
+		ret = 0;
+		break;
+	case POWER_SUPPLY_PROP_CAPACITY_LEVEL:
+		ret = max77865_read_capacity(data);
+		if (ret < 0)
+			goto out;
+		value->intval = ret >= 95 ? POWER_SUPPLY_CAPACITY_LEVEL_FULL :
+				ret >= 80 ? POWER_SUPPLY_CAPACITY_LEVEL_HIGH :
+				ret <= 5 ? POWER_SUPPLY_CAPACITY_LEVEL_CRITICAL :
+				ret <= 15 ? POWER_SUPPLY_CAPACITY_LEVEL_LOW :
+				POWER_SUPPLY_CAPACITY_LEVEL_NORMAL;
+		ret = 0;
+		break;
+	case POWER_SUPPLY_PROP_TEMP:
+		ret = max77865_read_temperature(data, &value->intval);
+		break;
+	case POWER_SUPPLY_PROP_CYCLE_COUNT:
+		ret = max77865_read16(data->fuelgauge, MAX77865_REG_FG_CYCLES,
+				      &raw);
+		if (ret)
+			goto out;
+		value->intval = raw;
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+out:
+	mutex_unlock(&data->lock);
+	return ret;
+}
+
+static enum power_supply_property max77865_battery_properties[] = {
+	POWER_SUPPLY_PROP_STATUS,
+	POWER_SUPPLY_PROP_HEALTH,
+	POWER_SUPPLY_PROP_PRESENT,
+	POWER_SUPPLY_PROP_ONLINE,
+	POWER_SUPPLY_PROP_TECHNOLOGY,
+	POWER_SUPPLY_PROP_VOLTAGE_NOW,
+	POWER_SUPPLY_PROP_CURRENT_NOW,
+	POWER_SUPPLY_PROP_CURRENT_AVG,
+	POWER_SUPPLY_PROP_CAPACITY,
+	POWER_SUPPLY_PROP_CAPACITY_LEVEL,
+	POWER_SUPPLY_PROP_TEMP,
+	POWER_SUPPLY_PROP_CYCLE_COUNT,
+};
+
+static enum power_supply_property max77865_usb_properties[] = {
+	POWER_SUPPLY_PROP_STATUS,
+	POWER_SUPPLY_PROP_HEALTH,
+	POWER_SUPPLY_PROP_ONLINE,
+};
+
+static const struct power_supply_desc max77865_battery_desc = {
+	.name = "battery",
+	.type = POWER_SUPPLY_TYPE_BATTERY,
+	.properties = max77865_battery_properties,
+	.num_properties = ARRAY_SIZE(max77865_battery_properties),
+	.get_property = max77865_battery_get_property,
+};
+
+static const struct power_supply_desc max77865_usb_desc = {
+	.name = "usb",
+	.type = POWER_SUPPLY_TYPE_USB,
+	.properties = max77865_usb_properties,
+	.num_properties = ARRAY_SIZE(max77865_usb_properties),
+	.get_property = max77865_battery_get_property,
+};
+
+static void max77865_power_poll(struct work_struct *work)
+{
+	struct max77865_power *data = container_of(work,
+						   struct max77865_power,
+						   poll_work.work);
+
+	power_supply_changed(data->battery);
+	power_supply_changed(data->usb);
+	schedule_delayed_work(&data->poll_work,
+			      msecs_to_jiffies(MAX77865_POLL_MS));
+}
+
+static int max77865_power_probe(struct i2c_client *client)
+{
+	struct power_supply_config psy_cfg = {};
+	struct max77865_power *data;
+	int id;
+
+	data = devm_kzalloc(&client->dev, sizeof(*data), GFP_KERNEL);
+	if (!data)
+		return -ENOMEM;
+
+	data->dev = &client->dev;
+	data->pmic = client;
+	mutex_init(&data->lock);
+	i2c_set_clientdata(client, data);
+
+	data->charger = devm_i2c_new_dummy_device(&client->dev,
+						  client->adapter,
+						  MAX77865_I2C_CHARGER);
+	if (IS_ERR(data->charger))
+		return dev_err_probe(&client->dev, PTR_ERR(data->charger),
+				     "failed to create charger client\n");
+
+	data->fuelgauge = devm_i2c_new_dummy_device(&client->dev,
+						   client->adapter,
+						   MAX77865_I2C_FUELGAUGE);
+	if (IS_ERR(data->fuelgauge))
+		return dev_err_probe(&client->dev, PTR_ERR(data->fuelgauge),
+				     "failed to create fuel-gauge client\n");
+
+	id = i2c_smbus_read_byte_data(client, MAX77865_REG_PMIC_ID);
+	if (id < 0)
+		return dev_err_probe(&client->dev, id, "failed to read PMIC ID\n");
+	if (id != 0x54 && id != 0x65)
+		dev_warn(&client->dev, "unexpected PMIC ID 0x%02x\n", id);
+
+	psy_cfg.drv_data = data;
+	psy_cfg.fwnode = dev_fwnode(&client->dev);
+	data->battery = devm_power_supply_register(&client->dev,
+						   &max77865_battery_desc,
+						   &psy_cfg);
+	if (IS_ERR(data->battery))
+		return dev_err_probe(&client->dev, PTR_ERR(data->battery),
+				     "failed to register battery power supply\n");
+
+	data->usb = devm_power_supply_register(&client->dev, &max77865_usb_desc,
+						      &psy_cfg);
+	if (IS_ERR(data->usb))
+		return dev_err_probe(&client->dev, PTR_ERR(data->usb),
+				     "failed to register USB power supply\n");
+
+	INIT_DELAYED_WORK(&data->poll_work, max77865_power_poll);
+	schedule_delayed_work(&data->poll_work, msecs_to_jiffies(500));
+
+	dev_info(&client->dev, "MAX77854/65 battery monitor ready (ID 0x%02x)\n",
+		 id);
+	return 0;
+}
+
+static void max77865_power_remove(struct i2c_client *client)
+{
+	struct max77865_power *data = i2c_get_clientdata(client);
+
+	cancel_delayed_work_sync(&data->poll_work);
+	mutex_destroy(&data->lock);
+}
+
+static const struct of_device_id max77865_power_of_match[] = {
+	{ .compatible = "maxim,max77865" },
+	{ .compatible = "maxim,max77854" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, max77865_power_of_match);
+
+static const struct i2c_device_id max77865_power_id[] = {
+	{ "max77865-battery" },
+	{ "max77854-battery" },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, max77865_power_id);
+
+static struct i2c_driver max77865_power_driver = {
+	.driver = {
+		.name = "max77865-battery",
+		.of_match_table = max77865_power_of_match,
+	},
+	.probe = max77865_power_probe,
+	.remove = max77865_power_remove,
+	.id_table = max77865_power_id,
+};
+module_i2c_driver(max77865_power_driver);
+
+MODULE_AUTHOR("LinuxS8 bring-up");
+MODULE_DESCRIPTION("Read-only MAX77854/MAX77865 battery and charger monitor");
+MODULE_LICENSE("GPL");
