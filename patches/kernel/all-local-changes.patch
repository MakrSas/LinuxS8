+			freq-table-hz = <0 0>, <0 0>;
+			/*
+			 * Взято дословно из dts даунстрима, и верхняя граница
+			 * тут не описка: core_clk равен 166.5625 МГц, то есть
+			 * чуть ВЫШЕ 166 МГц, поэтому цикл деления в
