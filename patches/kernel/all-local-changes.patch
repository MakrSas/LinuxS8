diff --git a/drivers/pci/controller/dwc/pcie-exynos8895-quirk.c b/drivers/pci/controller/dwc/pcie-exynos8895-quirk.c
new file mode 100644
index 000000000..8b7353d1f
--- /dev/null
+++ b/drivers/pci/controller/dwc/pcie-exynos8895-quirk.c
@@ -0,0 +1,79 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Встроенная часть драйвера PCIe Exynos8895: PCI fixup не работает из модуля,
+ * а сам контроллер собран модулем, чтобы падение при probe не роняло загрузку.
+ *
+ * Окно памяти канала 0 — 4 МиБ (0x11800000..0x11bfffff), последние 4 КиБ из
+ * него заняты под config space. BCM4361 просит BAR2 = 4 МиБ и BAR0 = 32 КиБ,
+ * а общий распределитель ещё и округляет окно моста до 1 МиБ, так что
+ * раскладку делаем вручную, как вендор (quirk_brcm_header/enable):
+ *   BAR2 -> 0x11800000, урезан до 3 МиБ (прошивке хватает);
+ *   BAR0 -> 0x11b00000;
+ *   окно root port -> 0x11800000..0x11bfffff (ядро обрежет по окну хоста).
+ * Контроллер ставит bridge->preserve_config, и ядро эту раскладку только
+ * принимает.
+ */
+
+#include <linux/of.h>
+#include <linux/pci.h>
+#include <linux/sizes.h>
+
+#define EX8895_MEM_BASE		0x11800000
+#define EX8895_BAR2_SIZE	(SZ_2M + SZ_1M)
+#define EX8895_BAR0_BASE	0x11b00000
+#define EX8895_WINDOW_LIMIT	0x11bfffff
+
+static bool ex8895_bus(struct pci_dev *dev)
+{
+	struct pci_host_bridge *bridge = pci_find_host_bridge(dev->bus);
+
+	return bridge && bridge->dev.parent &&
+	       of_device_is_compatible(bridge->dev.parent->of_node,
+				       "samsung,exynos8895-pcie");
+}
+
+static void ex8895_set_bar(struct pci_dev *dev, int bar, u32 base, u32 size)
+{
+	struct resource *res = &dev->resource[bar];
+	int reg = PCI_BASE_ADDRESS_0 + bar * 4;
+
+	pci_write_config_dword(dev, reg, base);
+	if (res->flags & IORESOURCE_MEM_64)
+		pci_write_config_dword(dev, reg + 4, 0);
+
+	res->start = base;
+	res->end = base + size - 1;
+	res->flags &= ~IORESOURCE_UNSET;
+	res->flags |= IORESOURCE_PCI_FIXED;
+}
+
+static void ex8895_quirk_brcm(struct pci_dev *dev)
+{
+	if (!ex8895_bus(dev))
+		return;
+
+	ex8895_set_bar(dev, 2, EX8895_MEM_BASE, EX8895_BAR2_SIZE);
+	ex8895_set_bar(dev, 0, EX8895_BAR0_BASE, resource_size(&dev->resource[0]));
+	pci_info(dev, "exynos8895: fixed BAR2 %pR, BAR0 %pR\n",
+		 &dev->resource[2], &dev->resource[0]);
+}
+DECLARE_PCI_FIXUP_HEADER(PCI_VENDOR_ID_BROADCOM, PCI_ANY_ID, ex8895_quirk_brcm);
+
+static void ex8895_quirk_root_port(struct pci_dev *dev)
+{
+	if (!ex8895_bus(dev) || pci_pcie_type(dev) != PCI_EXP_TYPE_ROOT_PORT)
+		return;
+
+	/* памятное окно моста; I/O и prefetchable выключены (base > limit) */
+	pci_write_config_word(dev, PCI_MEMORY_BASE, (EX8895_MEM_BASE >> 16) & 0xfff0);
+	pci_write_config_word(dev, PCI_MEMORY_LIMIT, (EX8895_WINDOW_LIMIT >> 16) & 0xfff0);
+	pci_write_config_word(dev, PCI_PREF_MEMORY_BASE, 0xfff0);
+	pci_write_config_word(dev, PCI_PREF_MEMORY_LIMIT, 0x0000);
+	pci_write_config_dword(dev, PCI_PREF_BASE_UPPER32, 0);
+	pci_write_config_dword(dev, PCI_PREF_LIMIT_UPPER32, 0);
+	pci_write_config_byte(dev, PCI_IO_BASE, 0xf0);
+	pci_write_config_byte(dev, PCI_IO_LIMIT, 0x00);
+	pci_info(dev, "exynos8895: root port window %#x-%#x\n",
+		 EX8895_MEM_BASE, EX8895_WINDOW_LIMIT);
+}
+DECLARE_PCI_FIXUP_HEADER(PCI_VENDOR_ID_SAMSUNG, PCI_ANY_ID, ex8895_quirk_root_port);
diff --git a/drivers/pci/controller/dwc/pcie-exynos8895.c b/drivers/pci/controller/dwc/pcie-exynos8895.c
new file mode 100644
index 000000000..b47797ca7
--- /dev/null
+++ b/drivers/pci/controller/dwc/pcie-exynos8895.c
@@ -0,0 +1,564 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * PCIe контроллер Exynos 8895 (канал 0, Wi-Fi BCM4361 на Galaxy S8).
+ *
+ * Последовательность перенесена целиком из вендорского ядра 4.4
+ * (drivers/pci/host/pci-exynos.c + pci-exynos8895_cal.c): питание PHY через
+ * PMU, таблицы PHY для 26 МГц Gen1, ELBI-регистры обёртки. Ядро контроллера —
+ * обычный DesignWare, им управляет общий код dwc.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/interrupt.h>
+#include <linux/mfd/syscon.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/pci.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+#include <linux/sizes.h>
+
+#include "pcie-designware.h"
+
+/* ELBI (обёртка Samsung) */
+#define ELBI_IRQ_PULSE			0x000
+#define ELBI_IRQ_EN_PULSE		0x00c
+#define  IRQ_INTX_ASSERT		(BIT(0) | BIT(2) | BIT(4) | BIT(6))
+#define ELBI_IRQ_EN_LEVEL		0x010
+#define ELBI_IRQ_EN_SPECIAL		0x014
+#define ELBI_SW_WAKE			0x018
+#define  SW_WAKE_BUS_EN			BIT(1)
+#define ELBI_APP_LTSSM_ENABLE		0x02c
+#define ELBI_IRQ_TOE_EN_PULSE		0x030
+#define ELBI_IRQ_TOE_EN_PULSE2		0x034
+#define ELBI_L1_BUG_FIX_ENABLE		0x038	/* совпадает с TOE_EN_LEVEL */
+#define ELBI_RDLH_LINKUP		0x074
+#define  LTSSM_MASK			0x1f
+#define ELBI_APP_REQ_EXIT_L1_MODE	0x0f4
+#define  APP_REQ_EXIT_L1_MODE		BIT(0)
+#define  L1_REQ_NAK_CONTROL_MASTER	BIT(4)
+#define ELBI_LINKDOWN_RST_CTRL_SEL	0x1b8
+#define  LINKDOWN_RST_MANUAL		BIT(1)
+#define ELBI_SOFT_CORE_RESET		0x1d0
+#define ELBI_STATE_HISTORY_CHECK	0x274
+#define  HISTORY_BUFFER_ENABLE		BIT(0)
+#define ELBI_PCS_G_RST			0x288
+#define ELBI_PHY_CMN_RST		0x28c
+#define ELBI_MAC_RST			0x290
+#define ELBI_QCH_SEL			0x2c8
+#define  QCH_CLOCK_GATING_MASK		GENMASK(11, 0)
+
+/* PMU */
+#define PMU_WAKEUP_MASK			0x610
+#define  WAKEUP_MASK_PCIE_WIFI0		BIT(5)
+#define PMU_PCIE_PHY_CONTROL		0x71c
+
+/* SYSREG FSYS1 + 0x1044 */
+#define SYSREG_PCIE			0x0
+#define SYSREG_PCIE_PHY_CONTROL		0xc
+#define  BIFURCATION_MODE_DISABLE	BIT(16)
+#define  LINK0_ENABLE			BIT(14)
+#define  PCS_LANE0_ENABLE		BIT(12)
+
+/* PCS */
+#define PCS_RX_ELECIDLE			0xec
+
+/* Порт-логика DWC, не описанная в pcie-designware.h */
+#define DBI_AUX_CLK_FREQ		0xb40
+#define  AUX_CLK_FREQ_26MHZ		0x1a
+#define DBI_L1_SUBSTATES		0xb44
+#define  L1_SUB_VAL			0xea
+
+#define PCI_DEVICE_ID_EXYNOS8895	0xecec
+
+struct exynos8895_pcie {
+	struct dw_pcie		pci;
+	void __iomem		*phy;
+	void __iomem		*pcs;
+	struct regmap		*pmu;
+	struct regmap		*sysreg;
+	u32			sysreg_off;
+	struct clk_bulk_data	*clks;
+	int			num_clks;
+	struct gpio_desc	*perst;
+	struct gpio_desc	*wlan_en;
+};
+
+#define to_ex(x)	dev_get_drvdata((x)->dev)
+
+/* Таблицы PHY из вендорского pci-exynos8895_cal.c (26 МГц, Gen1). */
+static const u8 cmn_config_val[48] = {
+	0x01, 0xE1, 0x05, 0x00, 0x88, 0x88, 0x88, 0x04, 0x31, 0x45, 0x65, 0x24, 0x33, 0x08, 0xA4, 0xFC,
+	0xC6, 0x05, 0xE6, 0x80, 0x00, 0x00, 0x00, 0x00, 0x60, 0x11, 0x00, 0x90, 0x10, 0x04, 0x4E, 0x8E,
+	0xC0, 0xFF, 0x9B, 0x52, 0x22, 0x73, 0x47, 0x8C, 0x40, 0x00, 0x22, 0xFF, 0xFF, 0xFF, 0x00, 0x80,
+};
+
+static const u8 trsv_config_val[156] = {
+	/* Ch0 */
+	0x31, 0x40, 0x37, 0x99, 0x85, 0x00, 0xC0, 0xFF, 0xFF, 0x3F, 0x8C, 0xC8, 0x02, 0x01, 0x88, 0x80,
+	0x06, 0x90, 0x68, 0x66, 0x09, 0x31, 0x42, 0x44, 0xC6, 0x18, 0x03, 0x33, 0x58, 0xE7, 0x20, 0x22,
+	0x80, 0x38, 0x05, 0x85, 0x00, 0x00, 0x00, 0x7E, 0x00, 0x00, 0x55, 0x15, 0xAC, 0xAA, 0x3E, 0x00,
+	0x00, 0x00, 0x00, 0x3F, 0x00, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
+	0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x40, 0x05, 0x85, 0xFF, 0x00, 0x00, 0x00, 0x00, 0x00,
+	/* Ch1 */
+	0x81, 0x40, 0x37, 0x99, 0x85, 0x00, 0xC0, 0xFF, 0xFF, 0x3F, 0x8C, 0xC8, 0x02, 0x01, 0x88, 0x80,
+	0x06, 0x90, 0x68, 0x66, 0x09, 0x31, 0x42, 0x44, 0xC6, 0x18, 0x03, 0x33, 0x58, 0xE7, 0x20, 0x22,
+	0x80, 0x38, 0x05, 0x85, 0x00, 0x00, 0x00, 0x7E, 0x00, 0x00, 0x55, 0x15, 0xAC, 0xAA, 0x3E, 0x00,
+	0x00, 0x00, 0x00, 0x3F, 0x00, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
+	/* Gen1 */
+	0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x40, 0x05, 0x85, 0xFF, 0x00,
+};
+
+static void elbi_writel(struct exynos8895_pcie *ex, u32 val, u32 reg)
+{
+	writel(val, ex->pci.elbi_base + reg);
+}
+
+static u32 elbi_readl(struct exynos8895_pcie *ex, u32 reg)
+{
+	return readl(ex->pci.elbi_base + reg);
+}
+
+static void elbi_set(struct exynos8895_pcie *ex, u32 reg, u32 clr, u32 set)
+{
+	elbi_writel(ex, (elbi_readl(ex, reg) & ~clr) | set, reg);
+}
+
+static bool ex_ltssm_linked(struct exynos8895_pcie *ex)
+{
+	u32 st = elbi_readl(ex, ELBI_RDLH_LINKUP) & LTSSM_MASK;
+
+	return st >= 0x0d && st <= 0x14;
+}
+
+/* Пока линк не поднят, DBI надо читать с выключенной проверкой rx elecidle. */
+static void ex_rx_elecidle(struct exynos8895_pcie *ex, bool ignore)
+{
+	u32 v = readl(ex->pcs + PCS_RX_ELECIDLE);
+
+	v &= ~BIT(3);
+	if (ignore)
+		v |= BIT(3);
+	writel(v, ex->pcs + PCS_RX_ELECIDLE);
+}
+
+static u32 ex_read_dbi(struct dw_pcie *pci, void __iomem *base, u32 reg,
+		       size_t size)
+{
+	struct exynos8895_pcie *ex = to_ex(pci);
+	bool linked = ex_ltssm_linked(ex);
+	u32 val;
+
+	if (!linked)
+		ex_rx_elecidle(ex, true);
+	dw_pcie_read(base + reg, size, &val);
+	if (!linked)
+		ex_rx_elecidle(ex, false);
+	return val;
+}
+
+static void ex_write_dbi(struct dw_pcie *pci, void __iomem *base, u32 reg,
+			 size_t size, u32 val)
+{
+	struct exynos8895_pcie *ex = to_ex(pci);
+	bool linked = ex_ltssm_linked(ex);
+
+	if (!linked)
+		ex_rx_elecidle(ex, true);
+	dw_pcie_write(base + reg, size, val);
+	if (!linked)
+		ex_rx_elecidle(ex, false);
+}
+
+static void ex_phy_write_tables(struct exynos8895_pcie *ex)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(cmn_config_val); i++)
+		writel(cmn_config_val[i], ex->phy + i * 4);
+	for (i = 0; i < ARRAY_SIZE(trsv_config_val); i++)
+		writel(trsv_config_val[i], ex->phy + (0x30 + i) * 4);
+}
+
+/* exynos_pcie_phy_config() из вендорского cal, ch0 */
+static void ex_phy_config(struct exynos8895_pcie *ex)
+{
+	u32 so = ex->sysreg_off;
+	u32 v;
+
+	regmap_update_bits(ex->sysreg, so + SYSREG_PCIE, BIT(1), 0);
+	regmap_read(ex->sysreg, so + SYSREG_PCIE_PHY_CONTROL, &v);
+	v &= ~(GENMASK(7, 4) | GENMASK(5, 2) | BIT(1));
+	v |= 0x3 << 2;
+	regmap_write(ex->sysreg, so + SYSREG_PCIE_PHY_CONTROL, v);
+
+	elbi_writel(ex, 0, ELBI_MAC_RST);
+	udelay(10);
+	elbi_writel(ex, 0, ELBI_PHY_CMN_RST);
+	udelay(10);
+	elbi_writel(ex, 1, ELBI_PCS_G_RST);
+	udelay(10);
+	elbi_writel(ex, 0, ELBI_PCS_G_RST);
+	udelay(10);
+	elbi_writel(ex, 1, ELBI_PCS_G_RST);
+	udelay(10);
+
+	ex_phy_write_tables(ex);
+
+	/* tx amplitude */
+	writel(0x14, ex->phy + 0x5c * 4);
+	/* tx latency, refclk out */
+	writel(0x70, ex->pcs + 0xf8);
+	writel(0x87, ex->pcs + 0x100);
+	writel(0x50, ex->pcs + 0x104);
+	/* PRGM_TIMEOUT_L1SS_VAL */
+	v = readl(ex->pcs + 0xc);
+	v &= ~BIT(1);
+	v |= BIT(4);
+	writel(v, ex->pcs + 0xc);
+
+	elbi_writel(ex, 1, ELBI_MAC_RST);
+	udelay(10);
+	elbi_writel(ex, 1, ELBI_PHY_CMN_RST);
+	udelay(10);
+
+	/* вендор пишет таблицы повторно после снятия сброса */
+	ex_phy_write_tables(ex);
+}
+
+#define STEP(fmt, ...) dev_info(ex->pci.dev, "step: " fmt "\n", ##__VA_ARGS__)
+
+/* Сброс ядра, PERST#, PHY — повторяется на каждой попытке поднять линк. */
+static void ex_link_bringup(struct exynos8895_pcie *ex)
+{
+	STEP("pcs first access");
+	ex_rx_elecidle(ex, true);
+
+	STEP("core reset, perst release");
+	elbi_writel(ex, 0, ELBI_SOFT_CORE_RESET);
+	udelay(20);
+	elbi_writel(ex, 1, ELBI_SOFT_CORE_RESET);
+
+	gpiod_set_value_cansleep(ex->perst, 0);	/* снять PERST# */
+	usleep_range(18000, 20000);
+
+	elbi_set(ex, ELBI_APP_REQ_EXIT_L1_MODE, 0,
+		 APP_REQ_EXIT_L1_MODE | L1_REQ_NAK_CONTROL_MASTER);
+	elbi_writel(ex, LINKDOWN_RST_MANUAL, ELBI_LINKDOWN_RST_CTRL_SEL);
+	elbi_set(ex, ELBI_QCH_SEL, QCH_CLOCK_GATING_MASK, 0);
+
+	STEP("phy config");
+	ex_phy_config(ex);
+
+	elbi_set(ex, ELBI_SW_WAKE, SW_WAKE_BUS_EN, 0);
+	elbi_writel(ex, 1, ELBI_L1_BUG_FIX_ENABLE);
+
+	elbi_writel(ex, IRQ_INTX_ASSERT, ELBI_IRQ_EN_PULSE);
+	elbi_writel(ex, 0, ELBI_IRQ_TOE_EN_PULSE2);
+	elbi_writel(ex, 0, ELBI_IRQ_EN_LEVEL);
+	elbi_writel(ex, 0, ELBI_IRQ_EN_SPECIAL);
+}
+
+static int ex_host_init(struct dw_pcie_rp *pp)
+{
+	struct dw_pcie *pci = to_dw_pcie_from_pp(pp);
+	struct exynos8895_pcie *ex = to_ex(pci);
+
+	/* раскладку BAR задаёт pcie-exynos8895-quirk.c, ядро её только принимает */
+	pp->bridge->preserve_config = 1;
+
+	STEP("wlan_en on");
+	/* WLAN_REG_ON: питание BCM4361, до поднятия линка */
+	gpiod_set_value_cansleep(ex->wlan_en, 1);
+	msleep(100);
+
+	STEP("pmu phy control");
+	regmap_update_bits(ex->pmu, PMU_WAKEUP_MASK, WAKEUP_MASK_PCIE_WIFI0, 0);
+	regmap_update_bits(ex->pmu, PMU_PCIE_PHY_CONTROL, BIT(0), BIT(0));
+
+	STEP("phy pwrdn clear");
+	/* phy all power down clear, ch0 */
+	writel(0xc0, ex->phy + 0x20 * 4);
+	writel(0x7e, ex->phy + 0xa7 * 4);
+
+	STEP("elbi first access");
+	elbi_set(ex, ELBI_STATE_HISTORY_CHECK, 0, HISTORY_BUFFER_ENABLE);
+
+	ex_link_bringup(ex);
+	return 0;
+}
+
+/* exynos_pcie_setup_rc(): вызывается после общего dw_pcie_setup_rc() */
+static void ex_setup_rc_extra(struct exynos8895_pcie *ex)
+{
+	struct dw_pcie *pci = &ex->pci;
+	u8 exp = dw_pcie_find_capability(pci, PCI_CAP_ID_EXP);
+	u8 pm = dw_pcie_find_capability(pci, PCI_CAP_ID_PM);
+	u32 v;
+
+	dw_pcie_dbi_ro_wr_en(pci);
+	dw_pcie_writew_dbi(pci, PCI_VENDOR_ID, PCI_VENDOR_ID_SAMSUNG);
+	dw_pcie_writew_dbi(pci, PCI_DEVICE_ID, PCI_DEVICE_ID_EXYNOS8895);
+
+	v = dw_pcie_readl_dbi(pci, exp + PCI_EXP_LNKCAP);
+	v &= ~(PCI_EXP_LNKCAP_L1EL | PCI_EXP_LNKCAP_MLW | PCI_EXP_LNKCAP_SLS);
+	v |= (0x7 << 15) | (0x1 << 4) | PCI_EXP_LNKCAP_SLS_5_0GB;
+	dw_pcie_writel_dbi(pci, exp + PCI_EXP_LNKCAP, v);
+
+	dw_pcie_writel_dbi(pci, DBI_AUX_CLK_FREQ, AUX_CLK_FREQ_26MHZ);
+	dw_pcie_writel_dbi(pci, DBI_L1_SUBSTATES, L1_SUB_VAL);
+	if (pm)
+		dw_pcie_writel_dbi(pci, pm + PCI_PM_CTRL, 0);
+
+	v = dw_pcie_readl_dbi(pci, exp + PCI_EXP_LNKCTL2);
+	v &= ~PCI_EXP_LNKCTL2_TLS;
+	v |= PCI_EXP_LNKCTL2_TLS_2_5GT;
+	dw_pcie_writel_dbi(pci, exp + PCI_EXP_LNKCTL2, v);
+	dw_pcie_dbi_ro_wr_dis(pci);
+
+	regmap_update_bits(ex->sysreg, ex->sysreg_off + SYSREG_PCIE_PHY_CONTROL,
+			   BIFURCATION_MODE_DISABLE | LINK0_ENABLE | PCS_LANE0_ENABLE,
+			   LINK0_ENABLE | PCS_LANE0_ENABLE);
+}
+
+#define EX_LINK_TRIES		10
+
+static int ex_start_link(struct dw_pcie *pci)
+{
+	struct exynos8895_pcie *ex = to_ex(pci);
+	int try, i;
+
+	for (try = 1; try <= EX_LINK_TRIES; try++) {
+		if (try > 1) {
+			/* как вендор: PERST#, LTSSM off, заново сброс + PHY + RC */
+			gpiod_set_value_cansleep(ex->perst, 1);
+			elbi_writel(ex, 0, ELBI_APP_LTSSM_ENABLE);
+			msleep(10);
+			ex_link_bringup(ex);
+			dw_pcie_setup_rc(&pci->pp);
+		}
+
+		ex_setup_rc_extra(ex);
+		ex_rx_elecidle(ex, false);
+		elbi_writel(ex, 1, ELBI_APP_LTSSM_ENABLE);
+
+		for (i = 0; i < 200; i++) {	/* 20 мс, как MAX_TIMEOUT у вендора */
+			if (ex_ltssm_linked(ex)) {
+				dev_info(pci->dev, "link up on try %d: %#x\n", try,
+					 elbi_readl(ex, ELBI_RDLH_LINKUP));
+				return 0;
+			}
+			udelay(100);
+		}
+		dev_info(pci->dev, "try %d: no link, LTSSM %#x\n", try,
+			 elbi_readl(ex, ELBI_RDLH_LINKUP));
+	}
+	return 0;	/* dw_pcie_wait_for_link() доложит итог */
+}
+
+static void ex_stop_link(struct dw_pcie *pci)
+{
+	elbi_writel(to_ex(pci), 0, ELBI_APP_LTSSM_ENABLE);
+}
+
+static bool ex_link_up(struct dw_pcie *pci)
+{
+	return ex_ltssm_linked(to_ex(pci));
+}
+
+static const struct dw_pcie_ops ex_dw_ops = {
+	.read_dbi	= ex_read_dbi,
+	.write_dbi	= ex_write_dbi,
+	.start_link	= ex_start_link,
+	.stop_link	= ex_stop_link,
+	.link_up	= ex_link_up,
+};
+
+/*
+ * Без MSI, как у вендора (use-msi = "false"): иначе ядро dwc поднимает свой
+ * iMSI-RX, brcmfmac включает MSI, а их импульс (ELBI бит 29) нам не на что
+ * повесить — dw_handle_msi_irq() модулям не экспортирован. Пустой msi_init
+ * отключает MSI-домен, и brcmfmac уходит на INTx (INTA уже разрешён).
+ */
+static int ex_msi_init(struct dw_pcie_rp *pp)
+{
+	return 0;
+}
+
+static const struct dw_pcie_host_ops ex_host_ops = {
+	.init = ex_host_init,
+	.msi_init = ex_msi_init,
+};
+
+/*
+ * BAR2 у BCM4361 аппаратно декодирует все 4 МиБ (0x11800000..0x11bfffff),
+ * так что BAR0 внутри этого окна чип не отличает от BAR2. Как у вендора
+ * (dw_pcie_prog_viewport_mem_outbound_index2): на шине BAR0 = 0x11c00000,
+ * а CPU видит его по 0x11b00000 через отдельное окно iATU. Для ядра BAR0
+ * остаётся ресурсом 0x11b00000 внутри окна хоста.
+ */
+#define ATU_VIEWPORT		0x900
+#define ATU_CR1			0x904
+#define ATU_CR2			0x908
+#define  ATU_ENABLE		BIT(31)
+#define ATU_LOWER_BASE		0x90c
+#define ATU_UPPER_BASE		0x910
+#define ATU_LIMIT		0x914
+#define ATU_LOWER_TARGET	0x918
+#define ATU_UPPER_TARGET	0x91c
+
+#define EX_BAR2_CPU		0x11800000
+#define EX_BAR2_LIMIT		0x11afffff
+#define EX_BAR0_CPU		0x11b00000
+#define EX_BAR0_BUS		0x11c00000
+#define EX_BAR0_WIN		SZ_64K
+
+static void ex_atu_ob_mem(struct dw_pcie *pci, u32 index, u32 cpu, u32 limit,
+			  u32 bus)
+{
+	dw_pcie_writel_dbi(pci, ATU_VIEWPORT, index);	/* outbound */
+	dw_pcie_writel_dbi(pci, ATU_LOWER_BASE, cpu);
+	dw_pcie_writel_dbi(pci, ATU_UPPER_BASE, 0);
+	dw_pcie_writel_dbi(pci, ATU_LIMIT, limit);
+	dw_pcie_writel_dbi(pci, ATU_LOWER_TARGET, bus);
+	dw_pcie_writel_dbi(pci, ATU_UPPER_TARGET, 0);
+	dw_pcie_writel_dbi(pci, ATU_CR1, 0);		/* MEM */
+	dw_pcie_writel_dbi(pci, ATU_CR2, ATU_ENABLE);
+}
+
+static void ex_remap_bar0(struct exynos8895_pcie *ex)
+{
+	struct dw_pcie *pci = &ex->pci;
+	struct pci_bus *bus;
+	struct pci_dev *pdev;
+
+	ex_atu_ob_mem(pci, 1, EX_BAR2_CPU, EX_BAR2_LIMIT, EX_BAR2_CPU);
+	ex_atu_ob_mem(pci, 2, EX_BAR0_CPU, EX_BAR0_CPU + EX_BAR0_WIN - 1,
+		      EX_BAR0_BUS);
+
+	list_for_each_entry(bus, &pci->pp.bridge->bus->children, node) {
+		list_for_each_entry(pdev, &bus->devices, bus_list) {
+			if (pdev->vendor != PCI_VENDOR_ID_BROADCOM)
+				continue;
+			pci_write_config_dword(pdev, PCI_BASE_ADDRESS_0, EX_BAR0_BUS);
+			pci_write_config_dword(pdev, PCI_BASE_ADDRESS_1, 0);
+			pci_info(pdev, "BAR0 on bus %#x, CPU %#x via iATU 2\n",
+				 EX_BAR0_BUS, EX_BAR0_CPU);
+		}
+	}
+}
+
+static irqreturn_t ex_irq(int irq, void *arg)
+{
+	struct exynos8895_pcie *ex = arg;
+
+	elbi_writel(ex, elbi_readl(ex, ELBI_IRQ_PULSE), ELBI_IRQ_PULSE);
+	return IRQ_HANDLED;
+}
+
+/* Отладка прерываний: состояние ELBI и LTSSM, cat .../elbi_irq */
+static ssize_t elbi_irq_show(struct device *dev, struct device_attribute *attr,
+			     char *buf)
+{
+	struct exynos8895_pcie *ex = dev_get_drvdata(dev);
+
+	return sysfs_emit(buf,
+			  "pulse %#x en_pulse %#x level %#x en_level %#x special %#x ltssm %#x\n",
+			  elbi_readl(ex, ELBI_IRQ_PULSE),
+			  elbi_readl(ex, ELBI_IRQ_EN_PULSE),
+			  elbi_readl(ex, 0x004), elbi_readl(ex, ELBI_IRQ_EN_LEVEL),
+			  elbi_readl(ex, 0x008), elbi_readl(ex, ELBI_RDLH_LINKUP));
+}
+static DEVICE_ATTR_RO(elbi_irq);
+
+static int ex_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct exynos8895_pcie *ex;
+	struct dw_pcie_rp *pp;
+	int ret;
+
+	ex = devm_kzalloc(dev, sizeof(*ex), GFP_KERNEL);
+	if (!ex)
+		return -ENOMEM;
+
+	ex->pci.dev = dev;
+	ex->pci.ops = &ex_dw_ops;
+	platform_set_drvdata(pdev, ex);
+
+	ex->pci.elbi_base = devm_platform_ioremap_resource_byname(pdev, "elbi");
+	if (IS_ERR(ex->pci.elbi_base))
+		return PTR_ERR(ex->pci.elbi_base);
+	ex->phy = devm_platform_ioremap_resource_byname(pdev, "phy");
+	if (IS_ERR(ex->phy))
+		return PTR_ERR(ex->phy);
+	ex->pcs = devm_platform_ioremap_resource_byname(pdev, "pcs");
+	if (IS_ERR(ex->pcs))
+		return PTR_ERR(ex->pcs);
+
+	ex->pmu = syscon_regmap_lookup_by_phandle(dev->of_node,
+						  "samsung,pmu-syscon");
+	if (IS_ERR(ex->pmu))
+		return dev_err_probe(dev, PTR_ERR(ex->pmu), "no PMU\n");
+	ex->sysreg = syscon_regmap_lookup_by_phandle_args(dev->of_node,
+							  "samsung,sysreg", 1,
+							  &ex->sysreg_off);
+	if (IS_ERR(ex->sysreg))
+		return dev_err_probe(dev, PTR_ERR(ex->sysreg), "no sysreg\n");
+
+	dev_info(dev, "step: clocks\n");
+	ex->num_clks = devm_clk_bulk_get_all_enabled(dev, &ex->clks);
+	if (ex->num_clks < 0)
+		return dev_err_probe(dev, ex->num_clks, "clocks\n");
+
+	ex->perst = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(ex->perst))
+		return dev_err_probe(dev, PTR_ERR(ex->perst), "reset gpio\n");
+	ex->wlan_en = devm_gpiod_get(dev, "wlan-en", GPIOD_OUT_LOW);
+	if (IS_ERR(ex->wlan_en))
+		return dev_err_probe(dev, PTR_ERR(ex->wlan_en), "wlan-en gpio\n");
+
+	pp = &ex->pci.pp;
+	pp->ops = &ex_host_ops;
+	pp->irq = platform_get_irq(pdev, 0);
+	if (pp->irq < 0)
+		return pp->irq;
+	ret = devm_request_irq(dev, pp->irq, ex_irq, IRQF_SHARED,
+			       "exynos8895-pcie", ex);
+	if (ret)
+		return ret;
+	pp->msi_irq[0] = -ENODEV;
+
+	ret = dw_pcie_host_init(pp);
+	if (!ret) {
+		ex_remap_bar0(ex);
+		device_create_file(dev, &dev_attr_elbi_irq);
+	}
+	if (ret) {
+		dev_err(dev, "host init failed: %d, LTSSM %#x\n", ret,
+			elbi_readl(ex, ELBI_RDLH_LINKUP));
+		gpiod_set_value_cansleep(ex->perst, 1);
+		gpiod_set_value_cansleep(ex->wlan_en, 0);
+	}
+	return ret;
+}
+
+static const struct of_device_id ex_of_match[] = {
+	{ .compatible = "samsung,exynos8895-pcie" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, ex_of_match);
+
+static struct platform_driver ex_driver = {
+	.probe = ex_probe,
+	.driver = {
+		.name = "exynos8895-pcie",
+		.of_match_table = ex_of_match,
+		.suppress_bind_attrs = true,
+	},
+};
+module_platform_driver(ex_driver);
+MODULE_DESCRIPTION("Samsung Exynos8895 PCIe host (Wi-Fi channel)");
+MODULE_LICENSE("GPL");
