+static int samsung_dsim_init_exynos8895(struct samsung_dsim *dsi)
+{
+	u32 irq_unmask, pll, reg;
+	int ret;
+
+	if (dsi->state & DSIM_STATE_INITIALIZED)
+		return 0;
+
+	if (dsi->lanes != 4)
+		return dev_err_probe(dsi->dev, -EINVAL,
+				     "Exynos8895 requires four DSI lanes\n");
