diff --git a/drivers/usb/typec/s2mm005.c b/drivers/usb/typec/s2mm005.c
new file mode 100644
index 000000000..aa2704bf9
--- /dev/null
+++ b/drivers/usb/typec/s2mm005.c
@@ -0,0 +1,245 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Samsung S2MM005 USB-C CCIC, first mainline bring-up driver.
+ *
+ * The controller contains its own Type-C/PD state machine.  This initial
+ * driver intentionally stops at the smallest useful boundary: it performs
+ * the vendor wake/reset sequence, owns the CCIC interrupt, logs the function
+ * state, and clears the interrupt SRAM.  It does not invent a MUIC routing
+ * command or pretend to implement PD policy yet.
+ *
+ * The register transactions are taken from the vendor tree:
+ * downstream-8895/drivers/ccic/s2mm005.c and s2mm005_cc.c.
+ */
+
+#include <linux/delay.h>
+#include <linux/i2c.h>
+#include <linux/interrupt.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/regmap.h>
+#include <linux/slab.h>
+#include <linux/workqueue.h>
+
+#define S2MM005_CMD_REG		0x0010
+#define S2MM005_FUNC_STATE_REG	0x0020
+#define S2MM005_STATUS_REG	0x0030
+#define S2MM005_LP_STATE_REG	0x0060
+
+struct s2mm005 {
+	struct device *dev;
+	struct regmap *regmap;
+	struct delayed_work initial_state_work;
+};
+
+static const struct regmap_config s2mm005_regmap_config = {
+	.reg_bits = 16,
+	.val_bits = 8,
+	.max_register = 0xffff,
+	.val_format_endian = REGMAP_ENDIAN_NATIVE,
+	.cache_type = REGCACHE_NONE,
+};
+
+static int s2mm005_read_state(struct s2mm005 *ccic, const char *where)
+{
+	u8 func[4], lp[4];
+	u32 func_word, lp_word;
+	int ret;
+
+	ret = regmap_bulk_read(ccic->regmap, S2MM005_FUNC_STATE_REG,
+				func, sizeof(func));
+	if (ret)
+		return ret;
+
+	ret = regmap_bulk_read(ccic->regmap, S2MM005_LP_STATE_REG,
+				lp, sizeof(lp));
+	if (ret)
+		return ret;
+
+	func_word = func[0] | (u32)func[1] << 8 |
+			(u32)func[2] << 16 | (u32)func[3] << 24;
+	lp_word = lp[0] | (u32)lp[1] << 8 |
+		  (u32)lp[2] << 16 | (u32)lp[3] << 24;
+
+	dev_info(ccic->dev,
+		 "%s: func=0x%08x pd_state=%u attach=%u source=%u dfp=%u "
+		 "reset=%u lp=0x%08x\n", where, func_word, func[0],
+		 !!(func_word & BIT(24)), !!(func_word & BIT(25)),
+		 !!(func_word & BIT(26)), !!(func_word & BIT(31)), lp_word);
+
+	return 0;
+}
+
+static int s2mm005_reset(struct s2mm005 *ccic)
+{
+	u8 wake;
+	u8 command[] = { 0x02, 0x01, 0x1c, 0x10, 0x01 };
+	int i, ret;
+
+	/* Exact vendor s2mm005_reset(): five reads of register 0x0008. */
+	for (i = 0; i < 5; i++) {
+		ret = regmap_bulk_read(ccic->regmap, 0x0008, &wake, 1);
+		if (ret)
+			return ret;
+	}
+
+	/* Exact vendor command: 02 01 1c 10 01 at register 0x0010. */
+	ret = regmap_bulk_write(ccic->regmap, S2MM005_CMD_REG,
+				command, sizeof(command));
+	if (ret)
+		return ret;
+
+	msleep(100);
+	return 0;
+}
+
+static int s2mm005_clear_irq(struct s2mm005 *ccic)
+{
+	/* Exact vendor s2mm005_int_clear(): one byte, value 0x01, at 0x0010. */
+	return regmap_write(ccic->regmap, S2MM005_CMD_REG, 0x01);
+}
+
+static int s2mm005_enable_auto_lpm(struct s2mm005 *ccic)
+{
+	u8 wake;
+	u8 command[] = { 0x0f, 0x06 };
+	int i, ret;
+
+	/* Exact vendor s2mm005_manual_LPM(..., 6): five wake reads. */
+	for (i = 0; i < 5; i++) {
+		ret = regmap_bulk_read(ccic->regmap, 0x0008, &wake, 1);
+		if (ret)
+			return ret;
+	}
+
+	/* Exact vendor probe command: 0f 06 at register 0x0010. */
+	udelay(10);
+	return regmap_bulk_write(ccic->regmap, S2MM005_CMD_REG,
+				 command, sizeof(command));
+}
+
+static irqreturn_t s2mm005_irq_thread(int irq, void *data)
+{
+	struct s2mm005 *ccic = data;
+	u8 status[48];
+	int ret;
+
+	/* Vendor process_cc_get_int_status() reads the 48-byte SRAM first. */
+	ret = regmap_bulk_read(ccic->regmap, S2MM005_STATUS_REG,
+				status, sizeof(status));
+	if (ret) {
+		dev_err(ccic->dev, "IRQ status read failed: %d\n", ret);
+		return IRQ_HANDLED;
+	}
+
+	ret = s2mm005_read_state(ccic, "IRQ");
+	if (ret)
+		dev_err(ccic->dev, "state read after IRQ failed: %d\n", ret);
+
+	ret = s2mm005_clear_irq(ccic);
+	if (ret)
+		dev_err(ccic->dev, "IRQ clear failed: %d\n", ret);
+
+	dev_dbg(ccic->dev, "IRQ SRAM: %*ph\n", 8, status);
+	return IRQ_HANDLED;
+}
+
+static void s2mm005_initial_state_work(struct work_struct *work)
+{
+	struct s2mm005 *ccic = container_of(to_delayed_work(work),
+					   struct s2mm005, initial_state_work);
+	int ret;
+
+	ret = s2mm005_read_state(ccic, "boot+200ms");
+	if (ret)
+		dev_err(ccic->dev, "delayed state read failed: %d\n", ret);
+}
+
+static void s2mm005_cancel_work(void *data)
+{
+	struct s2mm005 *ccic = data;
+
+	cancel_delayed_work_sync(&ccic->initial_state_work);
+}
+
+static int s2mm005_probe(struct i2c_client *client)
+{
+	struct s2mm005 *ccic;
+	int ret;
+
+	ccic = devm_kzalloc(&client->dev, sizeof(*ccic), GFP_KERNEL);
+	if (!ccic)
+		return -ENOMEM;
+
+	ccic->dev = &client->dev;
+	ccic->regmap = devm_regmap_init_i2c(client, &s2mm005_regmap_config);
+	if (IS_ERR(ccic->regmap))
+		return dev_err_probe(&client->dev, PTR_ERR(ccic->regmap),
+				     "regmap init failed\n");
+
+	i2c_set_clientdata(client, ccic);
+
+	ret = s2mm005_reset(ccic);
+	if (ret)
+		return dev_err_probe(&client->dev, ret, "reset failed\n");
+
+	ret = s2mm005_enable_auto_lpm(ccic);
+	if (ret)
+		return dev_err_probe(&client->dev, ret, "auto LPM enable failed\n");
+
+	ret = s2mm005_clear_irq(ccic);
+	if (ret)
+		return dev_err_probe(&client->dev, ret, "initial IRQ clear failed\n");
+
+	ret = s2mm005_read_state(ccic, "probe");
+	if (ret)
+		return dev_err_probe(&client->dev, ret, "probe state read failed\n");
+
+	if (client->irq <= 0)
+		return dev_err_probe(&client->dev, -EINVAL,
+				     "missing CCIC interrupt\n");
+
+	ret = devm_request_threaded_irq(&client->dev, client->irq, NULL,
+				       s2mm005_irq_thread,
+				       IRQF_TRIGGER_FALLING | IRQF_ONESHOT,
+				       "s2mm005", ccic);
+	if (ret)
+		return dev_err_probe(&client->dev, ret, "IRQ request failed\n");
+
+	INIT_DELAYED_WORK(&ccic->initial_state_work, s2mm005_initial_state_work);
+	ret = devm_add_action_or_reset(&client->dev, s2mm005_cancel_work, ccic);
+	if (ret)
+		return ret;
+	/* The userspace source-backed reset probe observes the new state after
+	 * roughly one second; keep this diagnostic check after that settle time. */
+	schedule_delayed_work(&ccic->initial_state_work, msecs_to_jiffies(1200));
+
+	dev_info(&client->dev, "diagnostic CCIC driver active, IRQ %d\n",
+		 client->irq);
+	return 0;
+}
+
+static const struct of_device_id s2mm005_of_match[] = {
+	{ .compatible = "samsung,s2mm005" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, s2mm005_of_match);
+
+static const struct i2c_device_id s2mm005_i2c_ids[] = {
+	{ "s2mm005", 0 },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, s2mm005_i2c_ids);
+
+static struct i2c_driver s2mm005_driver = {
+	.driver = {
+		.name = "s2mm005",
+		.of_match_table = s2mm005_of_match,
+	},
+	.probe = s2mm005_probe,
+	.id_table = s2mm005_i2c_ids,
+};
+module_i2c_driver(s2mm005_driver);
+
+MODULE_DESCRIPTION("Samsung S2MM005 USB-C CCIC bring-up driver");
+MODULE_LICENSE("GPL");
