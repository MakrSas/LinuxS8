#!/bin/busybox sh
# initramfs для dreamlte: найти Debian и передать управление systemd.
#
# Корень теперь на внутренней памяти (UFS, sda29 — бывший USERDATA), карта
# оставлена запасным вариантом. Порядок поиска именно такой: если вставлена
# карта со старой копией системы, грузиться всё равно надо с внутренней.
#
# Диагностическая версия этого файла (с дампами регистров dw_mmc, SMU и
# пинов) осталась в истории git — она сделала своё дело: причина оказалась в
# кодировании таймаута данных, см. patches/kernel/README.md. Здесь оставлено
# только то, что нужно для загрузки, плюс минимум маркеров на экран: другого
# канала вывода на этом устройстве нет.
/bin/busybox --install -s /bin

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null

# Экран 1440x2960 без ускорения отрисовывает консоль очень медленно, поэтому
# поток сообщений ядра надо придушить — иначе загрузка тонет в собственном
# логе. Ничего не теряется: всё попадёт в journal на корневой ФС
# (Storage=persistent), откуда это спокойно читается из TWRP после
# перезагрузки.
dmesg -n 4
clear

echo "=== dreamlte initramfs ==="

# Ни то, ни другое не появляется мгновенно: UFS проходит старт линка UniPro
# и смену режима питания, карта же сбрасывает частоту и переспрашивает себя
# несколько раз, прежде чем возникнет mmcblk0p1.
#
# sda29 (бывший USERDATA) идёт первым намеренно. Если в телефоне осталась
# карта со старой копией системы, грузиться всё равно надо с внутренней —
# иначе легко полдня править не тот корень.
ROOTDEV=""
i=0
while [ $i -lt 30 ]; do
	for dev in /dev/sda29 /dev/mmcblk0p1 /dev/mmcblk0; do
		if [ -b "$dev" ]; then
			ROOTDEV="$dev"
			break
		fi
	done
	[ -n "$ROOTDEV" ] && break
	i=$((i + 1))
	sleep 1
done

if [ -z "$ROOTDEV" ]; then
	echo "!! корень не появился за 30 секунд"
	echo "   /proc/partitions:"
	cat /proc/partitions
	dmesg | grep -iE "ufs|mmc|mmcblk" | tail -15
	exec sh
fi

echo "   найдено: $ROOTDEV (ждали ${i}с)"

mkdir -p /mnt/root
if ! mount -t ext4 "$ROOTDEV" /mnt/root; then
	echo "!! не смонтировалось: $ROOTDEV"
	dmesg | grep -iE "ext4|I/O error" | tail -10
	exec sh
fi

if [ ! -x /mnt/root/sbin/init ] && [ ! -L /mnt/root/sbin/init ]; then
	echo "!! на $ROOTDEV нет /sbin/init"
	ls /mnt/root
	exec sh
fi

echo "   Debian найден, передаю управление systemd"
echo ""

# Переносим служебные ФС в новый корень, а не бросаем их: systemd смонтирует
# их и сам, но перенос избавляет от повторного монтирования devtmpfs поверх
# уже живых нод и от гонки на раннем udev.
mount -o move /dev /mnt/root/dev 2>/dev/null || umount /dev 2>/dev/null
mount -o move /sys /mnt/root/sys 2>/dev/null || umount /sys 2>/dev/null
mount -o move /proc /mnt/root/proc 2>/dev/null || umount /proc 2>/dev/null

exec switch_root /mnt/root /sbin/init

# Сюда попадаем только если switch_root не сработал.
echo "!! switch_root не сработал"
exec sh
